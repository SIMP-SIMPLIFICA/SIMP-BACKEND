# Database
# Development: local Postgres via Docker
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fastify_auth?schema=public"
# Migrations: same as DATABASE_URL locally; in production use the direct URL (port 5432)
DATABASE_MIGRATION_URL="postgresql://postgres:postgres@localhost:5432/fastify_auth?schema=public"

# Redis
REDIS_URL="redis://:redis123@localhost:6379"

# JWT Configuration
JWT_ACCESS_SECRET="your-super-secret-access-key-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server Configuration
NODE_ENV="development"
PORT=3000
HOST="localhost"
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW="1m"

# Email Configuration (Development - MailHog)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@yourapp.com"
SMTP_FROM_NAME="Your App"

# Email Configuration (Production - Example with SendGrid)
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_PORT=587
# SMTP_USER="apikey"
# SMTP_PASS="your-sendgrid-api-key"

# Application URLs
APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:5173"

# File Upload
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_DIR="uploads"

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET="your-session-secret-key-min-32-chars"

# Monitoring & Logging
LOG_LEVEL="info"
ENABLE_REQUEST_LOGGING=true

# Observability (optional — leave blank to disable)
# Sentry: get DSN at https://sentry.io → Project Settings → Client Keys
SENTRY_DSN=
# Betterstack: get token at https://logs.betterstack.com → Sources
BETTERSTACK_SOURCE_TOKEN=

# Cloudflare R2 (S3-compatible object storage)
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="<r2-access-key-id>"
R2_SECRET_ACCESS_KEY="<r2-secret-access-key>"
R2_BUCKET_NAME="simp-files"
R2_PUBLIC_URL="https://<custom-domain-or-r2-dev-url>"

# Gov.br OAuth2 — Ambiente de Homologação (Staging)
# Credenciais obtidas em: https://staging.acesso.gov.br
GOVBR_CLIENT_ID="<client-id-do-portal-govbr>"
GOVBR_CLIENT_SECRET="<client-secret-do-portal-govbr>"
# Em desenvolvimento use ngrok: ngrok http 3333 → atualizar abaixo
GOVBR_REDIRECT_URI="https://<ngrok-id>.ngrok-free.app/councils/sign/callback"
GOVBR_AUTH_URL="https://sso.staging.acesso.gov.br"
GOVBR_SIGN_API_URL="https://assinatura-api.staging.iti.br"
# Escopos necessários no portal gov.br: openid profile email govbr_assinatura
# Mock Mode: pula o gov.br e simula assinatura bem-sucedida (útil sem credenciais reais)
USE_MOCK_GOVBR=false

# Features Flags
ENABLE_2FA=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_PASSWORD_RESET=true
ENABLE_AUDIT_LOGS=true

# Development
SWAGGER_ENABLED=true
PRISMA_STUDIO_PORT=5555

# Supabase
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
# Found at: Supabase Dashboard → Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET="<jwt-secret>"
