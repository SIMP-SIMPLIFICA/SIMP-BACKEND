# ─── Local-First MVP ─────────────────────────────────────────────────────────
# Este arquivo descreve o único ambiente suportado para desenvolvimento local:
# Postgres + Redis + MailHog + pgAdmin 4 via Docker Compose. Nenhuma credencial
# de nuvem é necessária para subir a aplicação localmente.
#
# Setup: docker compose up -d  →  npx prisma migrate dev  →  npm run db:seed  →  npm run dev

# Database (Postgres local via Docker — ver docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fastify_auth?schema=public"
# Opcionais: só usados se você tiver uma URL de migration direta (sem pooler)
# ou uma réplica de leitura configurada. Deixe em branco localmente.
DATABASE_MIGRATION_URL=
DATABASE_REPLICA_URL=

# Redis
REDIS_URL="redis://:redis123@localhost:6379"

# JWT Configuration
JWT_ACCESS_SECRET="your-super-secret-access-key-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server Configuration
NODE_ENV="development"
PORT=3000
HOST="localhost"
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW="1m"

# Limite estrito das rotas de autenticacao (login, registro, reset de senha)
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW="1m"

# Quantos proxies reversos existem a frente da aplicacao.
# CRITICO: define de onde vem `request.ip`, que e a CHAVE do rate limit.
#   0 = sem proxy (a aplicacao recebe conexoes diretas)
#   1 = um proxy reverso a frente (Render, Vercel, Cloudflare, nginx)
# NUNCA usar `true`/confiar em todos: isso deixa o cliente escolher o proprio
# X-Forwarded-For e, com isso, uma chave de rate limit nova a cada requisicao.
TRUST_PROXY=1

# Email Configuration (Development — MailHog, ver docker-compose.yml)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@simp.local"
SMTP_FROM_NAME="SIMP Simplifica"

# Application URLs
APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:5173"

# File Upload
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_DIR="uploads"

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET="your-session-secret-key-min-32-chars"

# Monitoring & Logging
LOG_LEVEL="info"
ENABLE_REQUEST_LOGGING=true

# Observability (optional — leave blank to disable)
# Sentry: get DSN at https://sentry.io → Project Settings → Client Keys
SENTRY_DSN=
# Betterstack: get token at https://logs.betterstack.com → Sources
BETTERSTACK_SOURCE_TOKEN=

# Armazenamento de arquivos: LOCAL, em disco (pasta `uploads/` na raiz do backend),
# servida em /uploads/ via @fastify/static. Não requer nenhuma credencial de nuvem.
# A URL pública dos arquivos é montada a partir de APP_URL (definida acima).
# O Cloudflare R2 foi removido — ver .specify/specs/hotfix-local-upload-protocols.md

# Gov.br OAuth2 — Ambiente de Homologação (Staging)
# Credenciais obtidas em: https://staging.acesso.gov.br
GOVBR_CLIENT_ID="<client-id-do-portal-govbr>"
GOVBR_CLIENT_SECRET="<client-secret-do-portal-govbr>"
# Em desenvolvimento use ngrok: ngrok http 3000 → atualizar abaixo
GOVBR_REDIRECT_URI="https://<ngrok-id>.ngrok-free.app/councils/sign/callback"
GOVBR_AUTH_URL="https://sso.staging.acesso.gov.br"
GOVBR_SIGN_API_URL="https://assinatura-api.staging.iti.br"
# Mock Mode: pula o gov.br e simula assinatura bem-sucedida — ligado por padrão
# localmente para não exigir credenciais reais do gov.br.
USE_MOCK_GOVBR=true

# Features Flags
ENABLE_2FA=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_PASSWORD_RESET=true
ENABLE_AUDIT_LOGS=true

# Development
SWAGGER_ENABLED=true
PRISMA_STUDIO_PORT=5555

# Cloudflare Turnstile (anti-bot invisivel)
# Chave SECRETA do servidor — obtida no painel da Cloudflare junto com a site key.
# A site key (publica) vai no frontend, em VITE_TURNSTILE_SITE_KEY.
# Deixar vazio DESLIGA a verificacao (util em dev local).
# Em producao, TURNSTILE_ENABLED=true sem esta chave impede o boot de proposito.
TURNSTILE_SECRET_KEY=""
# TURNSTILE_ENABLED="true"

# Chaves de TESTE da Cloudflare (sempre passam / sempre falham):
#   sempre passa: 1x0000000000000000000000000000000AA
#   sempre falha: 2x0000000000000000000000000000000AA
