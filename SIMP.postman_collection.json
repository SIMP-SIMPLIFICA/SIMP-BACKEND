{
  "info": {
    "name": "SIMP",
    "_postman_id": "simp-collection-v1",
    "description": "Sistema Integrado de Gestão Municipal — API Collection completa",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{meu_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.tokens && res.tokens.accessToken) {",
                  "  pm.globals.set('meu_token', res.tokens.accessToken);",
                  "  console.log('Token salvo:', res.tokens.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Admin123!@#\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","login"] }
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"novo@example.com\",\n  \"password\": \"Senha123!@#\",\n  \"firstName\": \"Nome\",\n  \"lastName\": \"Sobrenome\",\n  \"username\": \"novo_usuario\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","register"] }
          }
        },
        {
          "name": "Me (perfil autenticado)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{meu_token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/auth/me", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","me"] }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/refresh-token", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","refresh-token"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{meu_token}}", "type": "string" }] },
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/v1/auth/logout", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","logout"] }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","forgot-password"] }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{meu_token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"Admin123!@#\",\n  \"newPassword\": \"NovoAdmin123!@#\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/change-password", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","change-password"] }
          }
        }
      ]
    },
    {
      "name": "Communication",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{meu_token}}", "type": "string" }] },
      "item": [
        {
          "name": "Inbox (caixa de entrada)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/communication/inbox",
              "host": ["{{baseUrl}}"],
              "path": ["api","v1","communication","inbox"],
              "query": [
                { "key": "startDate", "value": "", "disabled": true },
                { "key": "endDate", "value": "", "disabled": true },
                { "key": "personId", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Enviados",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/communication/sent",
              "host": ["{{baseUrl}}"],
              "path": ["api","v1","communication","sent"],
              "query": [
                { "key": "startDate", "value": "", "disabled": true },
                { "key": "endDate", "value": "", "disabled": true },
                { "key": "personId", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Destinatários elegíveis",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/communication/recipients",
              "host": ["{{baseUrl}}"],
              "path": ["api","v1","communication","recipients"],
              "query": [
                { "key": "search", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Nova Mensagem",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"Assunto da mensagem\",\n  \"body\": \"Corpo da mensagem aqui.\",\n  \"recipients\": [\n    { \"userId\": \"ID_DO_DESTINATARIO\", \"role\": \"TO\" }\n  ],\n  \"attachments\": []\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/communication/messages", "host": ["{{baseUrl}}"], "path": ["api","v1","communication","messages"] }
          }
        },
        {
          "name": "Detalhe da Mensagem",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/communication/messages/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api","v1","communication","messages",":id"],
              "variable": [{ "key": "id", "value": "MESSAGE_ID" }]
            }
          }
        },
        {
          "name": "Atualizar Mensagem (rascunho)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"Assunto atualizado\",\n  \"body\": \"Corpo atualizado.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/communication/messages/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api","v1","communication","messages",":id"],
              "variable": [{ "key": "id", "value": "MESSAGE_ID" }]
            }
          }
        },
        {
          "name": "Deletar Mensagem",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/v1/communication/messages/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api","v1","communication","messages",":id"],
              "variable": [{ "key": "id", "value": "MESSAGE_ID" }]
            }
          }
        },
        {
          "name": "Download Anexo",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/communication/messages/:id/attachments/:attachmentId/download",
              "host": ["{{baseUrl}}"],
              "path": ["api","v1","communication","messages",":id","attachments",":attachmentId","download"],
              "variable": [
                { "key": "id", "value": "MESSAGE_ID" },
                { "key": "attachmentId", "value": "ATTACHMENT_ID" }
              ]
            }
          }
        }
      ]
    },
    {
