{
  "name": "fastify-auth-boilerplate",
  "version": "1.0.0",
  "description": "Stable Fastify v4 Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/src/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seeds/seed.ts",
    "db:seed:finance": "tsx src/scripts/seed-finance.ts",
    "db:reset": "prisma migrate reset",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src/**/*.ts",
    "type-check": "tsc --noEmit",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "env:local": "cp .env.local .env",
    "env:supabase": "cp .env.supabase .env"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/s3-request-presigner": "^3.1000.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^9.1.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.3",
    "@fastify/static": "^9.0.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.2",
    "@fastify/under-pressure": "^9.0.3",
    "@logtail/node": "^0.5.8",
    "@logtail/pino": "^0.5.8",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.8.2",
    "@sentry/node": "^10.46.0",
    "@types/node-cron": "^3.0.11",
    "docxtemplater": "^3.49.0",
    "dotenv": "^16.3.1",
    "fastify-type-provider-zod": "^4.0.2",
    "handlebars": "^4.7.8",
    "jose": "^6.0.11",
    "nanoid": "^5.0.4",
    "node-cron": "^4.2.1",
    "node-forge": "^1.3.1",
    "node-signpdf": "^3.0.0",
    "nodemailer": "^8.0.4",
    "pdf-lib": "^1.17.1",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "pizzip": "^3.1.6",
    "prisma": "^6.8.2",
    "qrcode": "^1.5.3",
    "redis": "^4.6.13",
    "speakeasy": "^2.0.0",
    "uuid": "^13.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/nodemailer": "^6.4.14",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "dotenv-expand": "^11.0.6",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "effect": ">=3.20.0"
  }
}
