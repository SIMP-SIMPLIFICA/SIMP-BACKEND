model LibraryDocument {
  id          String  @id @default(nanoid())
  title       String  @db.VarChar(500)
  fileName    String  @map("file_name")
  fileKey     String  @map("file_key") // chave no R2: organizations/{orgId}/library/{name}
  fileSize    Int     @map("file_size") // bytes
  mimeType    String  @default("application/pdf") @map("mime_type")
  accessLevel Int     @default(1) @map("access_level") // 1 | 2 | 3
  textContent String? @map("text_content") @db.Text // OCR para busca profunda

  uploaderId       String  @map("uploader_id") @db.Uuid
  organizationId   String  @map("organization_id")
  categoryId       String? @map("category_id")
  covenantId       String? @map("covenant_id")
  // Documento anexado via Convênio que pertence a um Processo Virtual específico.
  // Opcional: sem ele, o documento é "geral" do convênio.
  virtualProcessId String? @map("virtual_process_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  uploader         User              @relation("LibraryDocumentUploader", fields: [uploaderId], references: [id])
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category         DocumentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  covenant         Covenant?         @relation(fields: [covenantId], references: [id], onDelete: SetNull)
  // SetNull (nunca Cascade): excluir um processo NÃO pode apagar documento do
  // acervo do convênio — o arquivo apenas volta a ser "geral".
  virtualProcess   VirtualProcess?   @relation(fields: [virtualProcessId], references: [id], onDelete: SetNull)
  officialDocument OfficialDocument?

  @@index([organizationId, accessLevel])
  @@index([organizationId, deletedAt])
  @@index([uploaderId])
  @@index([categoryId])
  @@index([covenantId])
  @@index([virtualProcessId])
  @@map("library_documents")
}

