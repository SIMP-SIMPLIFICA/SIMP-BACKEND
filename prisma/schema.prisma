generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [unaccent]
}

enum AppRole {
  superadmin
  admin
  standard_user

  @@map("user_role")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  cnpj      String?  @unique
  /// Município e UF, para o texto padrão do Recibo ("Pequizeiro - TO").
  /// Distintos de `name` (razão institucional, ex: "PREFEITURA DE
  /// PEQUIZEIRO") — o Recibo pede só o nome da cidade.
  city      String?
  state     String?  @db.VarChar(2)
  plan      String   @default("basic")
  // Logo do tenant para o cabeçalho dos documentos oficiais (Épico 3, Task 3.4).
  // Guarda o fileKey do StorageService, e não uma URL absoluta: uma URL gravada
  // no banco apodrece quando APP_URL muda (dev -> produção) e não serve para ler
  // os bytes na hora de montar o PDF. A URL pública é derivada na leitura por
  // getFileUrl(). O nome do campo segue a convenção já usada em
  // CommunicationDocument.fileUrl, que também guarda fileKey.
  logoUrl   String?  @map("logo_url")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                    User[]
  roles                    Role[]
  departments              Department[]
  workspaces               Workspace[]
  communicationDocuments   CommunicationDocument[]
  notes                    Note[]
  calendarEvents           CalendarEvent[]
  auditLogs                AuditLog[]
  settings                 Setting[]
  notifications            Notification[]
  bankAccounts             BankAccount[]
  financeCategories        FinanceCategory[]
  financeEntries           FinanceEntry[]
  virtualProcesses         VirtualProcess[]
  virtualProcessCategories VirtualProcessCategory[]
  virtualProcessSources    VirtualProcessSource[]
  virtualProcessCompanies  VirtualProcessCompany[]
  modules                  OrganizationModule[]
  libraryDocuments         LibraryDocument[]
  documentCategories       DocumentCategory[]
  covenants                Covenant[]
  covenantTypes            CovenantType[]
  convenentes              Convenente[]
  concedentes              Concedente[]
  officialDocuments        OfficialDocument[]
  sequenceControls         SequenceControl[]
  councils                 Council[]
  councilMemberships       CouncilMembership[]
  councilMeetings          CouncilMeeting[]
  councilDocuments         CouncilDocument[]
  signatureRequests        SignatureRequest[]
  supportRequests          SupportRequest[]
  dailyAllowances          DailyAllowance[]
  fleetOwnerEntities       FleetOwnerEntity[]
  fleetVehicles            FleetVehicle[]
  fleetDrivers             FleetDriver[]
  fleetContracts           FleetContract[]
  fleetFuelings            FleetFueling[]
  fleetRedemptions         FleetFuelingRedemption[]
  fleetReceiptImages       FleetReceiptImage[]
  fleetTrips               FleetTrip[]
  fleetServiceOrders       FleetServiceOrder[]
  fleetServiceOrderItems   FleetServiceOrderItem[]
  fleetQualityAlerts       FleetQualityAlert[]
  beneficiaries            Beneficiary[]
  exportedDocuments        ExportedDocument[]
  councilDepartments       CouncilDepartment[]
  budgetLaws               BudgetLaw[]
  qddItems                 QddItem[]
  budgetHistories          BudgetHistory[]
  holidays                 Holiday[]

  @@map("organizations")
}

model OrganizationModule {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  module         String
  isEnabled      Boolean  @default(true) @map("is_enabled")
  enabledById    String?  @map("enabled_by_id")
  notes          String?
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, module])
  @@index([organizationId])
  @@map("organization_modules")
}

model User {
  id        String  @id @db.Uuid
  email     String  @unique
  username  String? @unique
  firstName String? @map("first_name")
  lastName  String? @map("last_name")
  fullName  String? @map("full_name")
  avatar    String?

  // Autenticação local (argon2 + jose) — Supabase Auth foi removido, ver ADR em docs/ProjectGoals.md §4
  password             String
  verifyToken          String?   @map("verify_token")
  passwordResetToken   String?   @map("password_reset_token")
  passwordResetExpires DateTime? @map("password_reset_expires")
  twoFactorEnabled     Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret      String?   @map("two_factor_secret")
  backupCodes          String[]  @map("backup_codes")

  jobTitle           String?   @map("job_title")
  municipalityName   String?   @map("municipality_name")
  role               AppRole   @default(standard_user) @map("role")
  isActive           Boolean   @default(true) @map("is_active")
  isVerified         Boolean   @default(true) @map("is_verified")
  lastLoginAt        DateTime? @map("last_login_at")
  metadata           Json?
  preferences        Json?
  isSuperAdmin       Boolean   @default(false) @map("is_super_admin")
  emailNotifications Boolean   @default(true) @map("email_notifications")
  autoClearDays      Int       @default(30) @map("auto_clear_days")
  clearanceLevel     Int       @default(1) @map("clearance_level")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])

  auditLogs AuditLog[]
  roles     UserRole[]
  sessions  UserSession[]

  workspaceMemberships WorkspaceMember[]
  createdTasks         Task[]            @relation("TaskCreator")
  assignedTasks        TaskAssignee[]
  taskNotes            TaskNote[]
  taskHistory          TaskHistory[]
  notifications        Notification[]

  createdDocuments   CommunicationDocument[] @relation("DocumentCreator")
  documentRecipients DocumentRecipient[]

  calendarEvents CalendarEvent[]
  notes          Note[]

  departments        Department[] @relation("DepartmentMembers")
  managedDepartments Department[] @relation("DepartmentManager")

  createdFinanceEntries FinanceEntry[]      @relation("FinanceEntryCreator")
  updatedFinanceEntries FinanceEntry[]      @relation("FinanceEntryUpdater")
  financeAttachments    FinanceAttachment[]

  createdProcesses         VirtualProcess[]         @relation("ProcessCreator")
  uploadedProcessDocuments VirtualProcessDocument[] @relation("ProcessDocumentUploader")

  uploadedLibraryDocs LibraryDocument[]  @relation("LibraryDocumentUploader")
  officialDocuments   OfficialDocument[]

  councilMemberships        CouncilMembership[]      @relation("CouncilMemberships")
  councilMeetingsCreated    CouncilMeeting[]         @relation("CouncilMeetingCreator")
  uploadedCouncilDocs       CouncilDocument[]        @relation("CouncilDocumentUploader")
  signatureRequests         SignatureRequest[]       @relation("SignatureRequester")
  supportRequests           SupportRequest[]         @relation("SupportAuthor")
  supportMessages           SupportMessage[]         @relation("SupportMessageSender")
  issuedDailyAllowances     DailyAllowance[]         @relation("DailyAllowanceIssuer")
  fleetOwnerEntitiesCreated FleetOwnerEntity[]       @relation("FleetOwnerEntityCreator")
  fleetVehiclesCreated      FleetVehicle[]           @relation("FleetVehicleCreator")
  fleetDriverProfiles       FleetDriver[]            @relation("FleetDriverUser")
  fleetDriversCreated       FleetDriver[]            @relation("FleetDriverCreator")
  fleetVehiclesUpdated      FleetVehicle[]           @relation("FleetVehicleUpdater")
  fleetDriversUpdated       FleetDriver[]            @relation("FleetDriverUpdater")
  fleetContractsCreated     FleetContract[]          @relation("FleetContractCreator")
  fleetFuelingsIssued       FleetFueling[]           @relation("FleetFuelingIssuer")
  fleetFuelings             FleetFueling[]           @relation("FleetFuelingCreator")
  fleetRedemptionsReviewed  FleetFuelingRedemption[] @relation("FleetRedemptionReviewer")
  fleetTripsRequested       FleetTrip[]              @relation("FleetTripRequester")
  fleetTripsApproved        FleetTrip[]              @relation("FleetTripApprover")
  fleetServiceOrdersCreated FleetServiceOrder[]      @relation("FleetServiceOrderCreator")
  fleetAlertsResolved       FleetQualityAlert[]      @relation("FleetAlertResolver")
  budgetHistoryEdits        BudgetHistory[]

  @@map("profiles")
}

model Role {
  id          String   @id @default(nanoid())
  name        String   @unique
  displayName String
  description String?
  color       String?
  permissions Json
  parentId    String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])

  parent   Role?      @relation("RoleHierarchy", fields: [parentId], references: [id])
  children Role[]     @relation("RoleHierarchy")
  users    UserRole[]

  @@map("roles")
}

model UserRole {
  id         String    @id @default(nanoid())
  userId     String    @db.Uuid
  roleId     String
  expiresAt  DateTime?
  assignedBy String?
  assignedAt DateTime  @default(now())
  metadata   Json?

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model UserSession {
  id           String   @id @default(nanoid())
  userId       String   @db.Uuid
  refreshToken String   @unique
  fingerprint  String?
  ipAddress    String?
  userAgent    String?
  isActive     Boolean  @default(true)
  lastUsedAt   DateTime @default(now())
  expiresAt    DateTime
  deviceType   String?
  deviceName   String?
  location     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model AuditLog {
  id           String   @id @default(nanoid())
  userId       String?  @db.Uuid
  action       String
  resource     String
  resourceId   String?
  method       String?
  endpoint     String?
  ipAddress    String
  userAgent    String?
  oldData      Json?
  newData      Json?
  metadata     Json?
  success      Boolean
  errorMessage String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

model RevokedToken {
  id        String   @id @default(nanoid())
  jti       String   @unique
  userId    String?
  reason    String?
  revokedAt DateTime @default(now())
  expiresAt DateTime

  @@index([jti])
  @@index([expiresAt])
  @@map("revoked_tokens")
}

model Setting {
  id          String   @id @default(nanoid())
  key         String   @unique
  value       Json
  type        String
  description String?
  isPublic    Boolean  @default(false)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@map("settings")
}

model Department {
  id          String   @id @default(nanoid())
  name        String
  code        String
  description String?
  /// CNPJ próprio do setor, quando possui inscrição separada da prefeitura.
  cnpj        String?
  /// Logo PRÓPRIA do setor, para o cabeçalho dos documentos dele.
  /// Guarda o fileKey do StorageService, não URL absoluta: URL gravada apodrece
  /// quando APP_URL muda de dev para produção, e não serve para ler os bytes na
  /// hora de montar o PDF. Ausente, o documento cai na logo da organização.
  logoUrl     String?  @map("logo_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  managerId String? @map("manager_id") @db.Uuid
  manager   User?   @relation("DepartmentManager", fields: [managerId], references: [id])

  members           User[]              @relation("DepartmentMembers")
  workspaces        Workspace[]
  officialDocuments OfficialDocument[]
  councils          CouncilDepartment[]
  covenants         Covenant[]
  virtualProcesses  VirtualProcess[]
  budgetLaws        BudgetLaw[]
  qddItems          QddItem[]
  dailyAllowances   DailyAllowance[]
  fleetVehicles     FleetVehicle[]
  fleetDrivers      FleetDriver[]
  fleetFuelings     FleetFueling[]
  fleetTrips        FleetTrip[]
  beneficiaries     Beneficiary[]
  bankAccounts      BankAccount[]

  @@unique([organizationId, code])
  @@map("departments")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  EXPIRED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Workspace {
  id          String   @id @default(uuid())
  name        String
  description String?
  slug        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])

  departmentId String?     @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id])

  members WorkspaceMember[]
  tasks   Task[]
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String        @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Task {
  id          String       @id @default(uuid())
  code        Int          @default(autoincrement())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?

  workspaceId String
  creatorId   String @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator   User      @relation("TaskCreator", fields: [creatorId], references: [id])

  assignees   TaskAssignee[]
  checklist   ChecklistItem[]
  attachments TaskAttachment[]
  notes       TaskNote[]
  history     TaskHistory[]
}

model TaskAssignee {
  taskId String
  userId String @db.Uuid

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
}

model ChecklistItem {
  id     String  @id @default(uuid())
  title  String
  isDone Boolean @default(false)
  taskId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskAttachment {
  id         String   @id @default(uuid())
  fileName   String
  fileUrl    String
  fileType   String
  fileSize   Int
  uploadedAt DateTime @default(now())
  taskId     String
  uploaderId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskNote {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  taskId    String
  authorId  String   @db.Uuid

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])
}

model TaskHistory {
  id        String   @id @default(uuid())
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
  taskId    String
  userId    String   @db.Uuid

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  userId    String   @db.Uuid
  read      Boolean  @default(false)
  type      String
  link      String?
  entityId  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

enum DocumentStatus {
  DRAFT
  SENT
  READ
  ARCHIVED
}

enum DocumentRole {
  TO
  CC
  BCC
}

model CommunicationDocument {
  id      String         @id @default(nanoid())
  title   String         @db.VarChar(500)
  content String         @db.Text
  status  DocumentStatus @default(DRAFT)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  sentAt    DateTime? @map("sent_at")
  readAt    DateTime? @map("read_at")

  createdBy String @map("created_by") @db.Uuid
  creator   User   @relation("DocumentCreator", fields: [createdBy], references: [id])

  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])

  recipients  DocumentRecipient[]
  attachments CommunicationAttachment[]

  @@map("communication_documents")
}

model DocumentRecipient {
  id         String       @id @default(nanoid())
  documentId String       @map("document_id")
  userId     String       @map("user_id") @db.Uuid
  role       DocumentRole @default(TO)
  canView    Boolean      @default(true) @map("can_view")
  readAt     DateTime?    @map("read_at")

  document CommunicationDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User                  @relation(fields: [userId], references: [id])

  @@map("document_recipients")
}

model CommunicationAttachment {
  id         String @id @default(nanoid())
  documentId String @map("document_id")
  fileName   String @map("file_name")
  fileUrl    String @map("file_url")
  fileType   String @map("file_type")
  fileSize   Int    @map("file_size")

  uploadedAt DateTime @default(now()) @map("uploaded_at")

  document CommunicationDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("communication_attachments")
}

enum FinanceEntryType {
  EXPENSE
  INCOME
}

model BankAccount {
  id                  String   @id @default(uuid())
  organizationId      String   @map("organization_id")
  name                String
  agency              String?
  accountNumber       String?
  /// Populado só pela futura integração bancária via API — a API MUST
  /// ignorar qualquer valor enviado pelo cliente em create/update (Épico 8,
  /// FR-016). Nunca exposto como campo editável, mesmo internamente.
  initialBalanceCents Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  /// Secretaria/Departamento responsável pela conta — vínculo obrigatório
  /// (Épico 8, FR-015). Restrict: uma conta bancária não pode ficar órfã por
  /// causa da exclusão do departamento.
  departmentId String @map("department_id")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  entries      FinanceEntry[]

  @@index([organizationId, departmentId])
  @@map("bank_accounts")
}

model FinanceCategory {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries      FinanceEntry[]

  @@unique([organizationId, name])
  @@map("finance_categories")
}

model FinanceEntry {
  id                String           @id @default(uuid())
  organizationId    String           @map("organization_id")
  occurredAt        DateTime
  description       String
  amountCents       Int
  type              FinanceEntryType @default(EXPENSE)
  categoryId        String?
  accountId         String?
  subcategoryName   String?
  nfeNumber         String?
  issueDate         DateTime?
  providerDocument  String? // CPF/CNPJ
  empenhoNumber     String?
  liquidacaoNumber  String?
  deliveryDate      DateTime?
  attachmentsStatus String           @default("none")
  createdById       String           @db.Uuid
  updatedById       String?          @db.Uuid
  deletedAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  attachments  FinanceAttachment[]
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     FinanceCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account      BankAccount?        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdBy    User                @relation("FinanceEntryCreator", fields: [createdById], references: [id])
  updatedBy    User?               @relation("FinanceEntryUpdater", fields: [updatedById], references: [id])

  @@index([organizationId, occurredAt])
  @@index([categoryId])
  @@index([accountId])
  @@map("finance_entries")
}

model FinanceAttachment {
  id         String   @id @default(uuid())
  entryId    String
  uploaderId String   @db.Uuid
  fileName   String
  fileType   String
  fileSize   Int
  fileUrl    String
  createdAt  DateTime @default(now())

  entry    FinanceEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  uploader User         @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@map("finance_attachments")
}

model VirtualProcess {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  /// Setor responsável. Opcional: o vínculo é informativo e nem todo registro
  /// histórico tem setor identificado.
  departmentId   String?   @map("department_id")
  processNumber  String    @map("process_number")
  secretaria     String
  source         String
  sourceDetail   String?   @map("source_detail")
  bankAccount    String?   @map("bank_account")
  agency         String?
  bankName       String?   @map("bank_name")
  companyCnpj    String?   @map("company_cnpj")
  companyName    String?   @map("company_name")
  startDate      DateTime? @map("start_date")
  endDate        DateTime? @map("end_date")
  // Vigência/validade legal do processo — é ESTA data que dispara os alertas de
  // vencimento na listagem. Distinta de endDate (quando o processo é arquivado).
  validityDate   DateTime? @map("validity_date")
  // Mesma convenção monetária de Covenant.transferValue.
  totalValue     Decimal?  @map("total_value") @db.Decimal(15, 2)
  subject        String    @db.Text
  status         String    @default("Tramitando")
  category       String    @default("Outros")

  /// Dotação orçamentária (ficha do QDD) que lastreia o processo — mesmo
  /// padrão já usado em DailyAllowance.qddItemId (Épico 8, FR-011).
  qddItemId String? @map("qdd_item_id")

  /// CÓPIA TEXTUAL da dotação no instante do vínculo. Mesmo motivo de
  /// DailyAllowance.qddFichaSnapshot: o processo não pode mudar de dotação
  /// retroativamente só porque o cadastro do QDD mudou depois.
  qddFichaSnapshot    String? @map("qdd_ficha_snapshot")
  qddFonteSnapshot    String? @map("qdd_fonte_snapshot")
  qddNaturezaSnapshot String? @map("qdd_natureza_snapshot")

  /// ESTOURO DE DOTAÇÃO: o vínculo é permitido mesmo acima do saldo restante
  /// da ficha (remanejamento é rotina), mas fica registrado — mesmo padrão de
  /// DailyAllowance.budgetOverrun.
  budgetOverrun Boolean @default(false) @map("budget_overrun")

  /// Fase oficial da despesa pública (Empenho/Liquidação/Pagamento).
  /// Dimensão ADICIONAL ao `status` textual acima — não o substitui (Épico 8,
  /// FR-019): `status` já é consumido por telas e filtros em produção.
  expensePhase ExpensePhase? @map("expense_phase")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String   @map("created_by_id") @db.Uuid

  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// SetNull: excluir um setor NÃO pode apagar convênio nem processo — são
  /// registros com valor próprio, não dependentes do setor.
  department       Department?              @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  creator          User                     @relation("ProcessCreator", fields: [createdById], references: [id])
  documents        VirtualProcessDocument[]
  covenants        Covenant[]
  // Documentos anexados via Convênio e atribuídos a este processo.
  libraryDocuments LibraryDocument[]
  /// Restrict: apagar uma dotação usada por processo vinculado apagaria o
  /// lastro de uma despesa já documentada (mesma regra de DailyAllowance).
  qddItem          QddItem?                 @relation(fields: [qddItemId], references: [id], onDelete: Restrict)

  @@unique([organizationId, processNumber])
  @@index([qddItemId])
  @@map("virtual_processes")
}

