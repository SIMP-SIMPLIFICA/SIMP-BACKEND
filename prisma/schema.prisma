// ─────────────────────────────────────────────────────────────────────────────
// Diárias de servidor (Épico 3, Task 3.1)
// ─────────────────────────────────────────────────────────────────────────────

model DailyAllowance {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")

  // Nome de quem viajou, GRAVADO COMO TEXTO e não como chave estrangeira.
  // Um documento oficial precisa preservar o nome que foi impresso nele: se o
  // beneficiário for renomeado ou excluído do cadastro depois, o recibo já
  // entregue ao Tribunal de Contas não pode mudar junto. É a mesma lógica da
  // imutabilidade do hash. O cadastro de Beneficiary serve para AUTOCOMPLETAR,
  // não para ser a fonte de verdade do documento emitido.
  beneficiaryName String @map("beneficiary_name")

  /// CÓPIA TEXTUAL dos dados de registro do beneficiário (Anexo I), no mesmo
  /// espírito de `beneficiaryName`: o `Beneficiary` é autocomplete, não fonte
  /// de verdade do documento — corrigir o cadastro depois não pode reescrever
  /// um Anexo I já emitido. Preenchidos na CRIAÇÃO do rascunho (o formulário
  /// os captura ali), não apenas na emissão.
  ///
  /// `beneficiaryCpf` é a ÚNICA exceção à máscara de CPF do sistema: o Anexo I
  /// é o formulário físico que o beneficiário assina para receber o valor, e
  /// precisa do número completo para ter validade. Nunca é devolvido por uma
  /// listagem — só pela consulta de UM registro, ao mesmo usuário que já
  /// pode ler a diária inteira.
  beneficiaryCpf                String? @map("beneficiary_cpf")
  beneficiaryRegistrationNumber String? @map("beneficiary_registration_number")
  beneficiaryRg                 String? @map("beneficiary_rg")
  /// Órgão emissor do RG — campo da cartilha oficial de prestação de contas
  /// (Épico 8), ausente do cadastro original do beneficiário.
  beneficiaryRgIssuer           String? @map("beneficiary_rg_issuer")
  beneficiaryJobTitle           String? @map("beneficiary_job_title")
  beneficiaryLotacao            String? @map("beneficiary_lotacao")
  beneficiaryBankName           String? @map("beneficiary_bank_name")
  beneficiaryBankAgency         String? @map("beneficiary_bank_agency")
  beneficiaryBankAccount        String? @map("beneficiary_bank_account")

  // Quem emitiu o documento — separado do beneficiário porque quase nunca são a
  // mesma pessoa, e a prestação de contas precisa saber quem autorizou.
  createdById String @map("created_by_id") @db.Uuid

  /// Setor ao qual a despesa é imputada.
  /// Obrigatório: despesa sem setor identificado não tem ordenador responsável.
  departmentId String @map("department_id")

  /// Dotação orçamentária (ficha do QDD) que lastreia a diária.
  qddItemId String? @map("qdd_item_id")

  /// Numeração legível ("Número da Diária"), mesmo padrão de
  /// OfficialDocument: sequencial por organização e ano, atribuído na
  /// criação do rascunho (Épico 8, FR-002). É o que a busca da listagem usa
  /// — `publicId` (UUID) não é digitável.
  sequenceNumber  Int    @map("sequence_number")
  year            Int
  formattedNumber String @map("formatted_number")

  status DailyAllowanceStatus @default(PENDING)

  /// ESTOURO DE DOTAÇÃO: a emissão é permitida (remanejamento e suplementação
  /// são rotina na administração pública), mas fica registrada para auditoria.
  budgetOverrun Boolean @default(false) @map("budget_overrun")

  // Identificador público, usado na URL de validação. Deliberadamente separado
  // da chave primária: o PK nunca vai para a internet, então podemos revogar ou
  // rotacionar um link público sem tocar em nenhuma chave estrangeira.
  publicId String @unique @default(uuid()) @map("public_id")

  destination String
  purpose     String @db.Text

  departureDate DateTime @map("departure_date")
  returnDate    DateTime @map("return_date")

  /// Texto livre, como no formulário físico ("EM ABERTO" quando ainda não
  /// definido) — não é um horário estruturado, é a mesma célula do papel.
  departureTime String? @map("departure_time")
  arrivalTime   String? @map("arrival_time")

  /// Justificativa legal exigida pelo TCE quando o período (departureDate a
  /// returnDate, inclusive) toca sábado, domingo ou feriado cadastrado em
  /// `Holiday` (Épico 8, FR-022). Obrigatória e bloqueante na EMISSÃO — a
  /// checagem acontece no servidor, em `issue()`, não no rascunho.
  weekendHolidayJustification String? @map("weekend_holiday_justification") @db.Text

  transportMeans TransportMeans? @map("transport_means")
  fundingSource  FundingSource?  @map("funding_source")

  // Decimal, nunca Float: valor público não admite erro de ponto flutuante.
  // dayCount é decimal porque meia diária (0.5) é praxe quando não há pernoite.
  dailyRate   Decimal @map("daily_rate") @db.Decimal(15, 2)
  dayCount    Decimal @map("day_count") @db.Decimal(5, 2)
  totalAmount Decimal @map("total_amount") @db.Decimal(15, 2)

  // Preenchidos na emissão do PDF. `sha256Hash` é o SHA-256 dos bytes do PDF
  // e é o que o Portal de Validação confere. Enquanto for nulo, o registro é
  // rascunho e pode ser editado; depois de preenchido, torna-se imutável — do
  // contrário o hash publicado deixaria de corresponder ao documento.
  sha256Hash String?   @map("sha256_hash")
  issuedAt   DateTime? @map("issued_at")
  // Chave do PDF emitido no StorageService. O arquivo é gerado UMA vez e
  // guardado: rege-lo a cada download produziria bytes diferentes (metadados de
  // data do pdf-lib) e o hash publicado deixaria de bater, fazendo o Portal de
  // Validação acusar adulteração num documento legítimo.
  pdfFileKey String?   @map("pdf_file_key")

  /// CÓPIA TEXTUAL da dotação no instante da emissão. Mesmo motivo de
  /// `beneficiaryName` ser texto: o documento emitido não pode mudar quando o
  /// cadastro do QDD muda. Preenchida na emissão, nunca na criação do rascunho.
  qddFichaSnapshot    String? @map("qdd_ficha_snapshot")
  qddFonteSnapshot    String? @map("qdd_fonte_snapshot")
  qddNaturezaSnapshot String? @map("qdd_natureza_snapshot")

  /// PRESTAÇÃO DE CONTAS (Anexo II).
  /// Preenchidos quando o servidor presta contas do deslocamento.
  accountabilityDate DateTime? @map("accountability_date")
  /// Relato da atividade desempenhada. Texto livre e longo.
  activityReport     String?   @map("activity_report") @db.Text

  /// Campos da cartilha oficial anexada pelo cliente (Épico 8, FR-003),
  /// capturados no momento da prestação de contas — não na criação do
  /// rascunho, pelo mesmo motivo de `accountabilityDate`/`activityReport`:
  /// o bilhete e o relato só existem depois da viagem.
  accountabilityTicketNumber String? @map("accountability_ticket_number")
  accountabilityEventAddress String? @map("accountability_event_address") @db.Text
  accountabilityContactsInfo String? @map("accountability_contacts_info") @db.Text

  /// O Anexo II é documento PRÓPRIO, com identificador e hash separados dos do
  /// Anexo I. São dois papéis distintos circulando: a solicitação e a
  /// prestação. Reaproveitar o mesmo publicId faria o Portal de Validação
  /// devolver o documento errado para metade dos QR Codes em circulação.
  accountabilityPublicId   String?   @unique @map("accountability_public_id")
  accountabilitySha256Hash String?   @map("accountability_sha256_hash")
  accountabilityPdfFileKey String?   @map("accountability_pdf_file_key")
  accountabilityIssuedAt   DateTime? @map("accountability_issued_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User                    @relation("DailyAllowanceIssuer", fields: [createdById], references: [id])
  department   Department              @relation(fields: [departmentId], references: [id])
  /// Restrict: apagar uma dotação usada por diária emitida apagaria o lastro de
  /// uma despesa já documentada.
  qddItem      QddItem?                @relation(fields: [qddItemId], references: [id], onDelete: Restrict)
  /// Notas fiscais comprobatórias da prestação de contas (Épico 8, FR-003) —
  /// imutáveis após o hash do Anexo II ser gravado.
  receipts     DailyAllowanceReceipt[]

  @@unique([organizationId, year, sequenceNumber])
  @@index([organizationId, departureDate])
  @@index([organizationId, beneficiaryName])
  @@index([qddItemId])
  /// Sustenta o filtro por situação e a varredura de prestações em atraso.
  @@index([organizationId, status, returnDate])
  @@map("daily_allowances")
}

/// Nota fiscal ou documento comprobatório de uma prestação de contas — campo
/// "Documentos Comprobatórios" da cartilha oficial (Épico 8, FR-003). Várias
/// por diária; sem `organizationId` próprio porque é sempre acessada através
/// de `DailyAllowance`, que já é escopada por organização (mesmo padrão de
/// `FinanceAttachment` e `VirtualProcessDocument`).
model DailyAllowanceReceipt {
  id               String @id @default(uuid())
  dailyAllowanceId String @map("daily_allowance_id")

  /// Número da nota fiscal ou documento comprobatório.
  receiptNumber String   @map("receipt_number")
  /// Favorecido — a quem a nota foi emitida.
  payeeName     String   @map("payee_name")
  issuedAt      DateTime @map("issued_at")
  amount        Decimal  @db.Decimal(15, 2)

  createdAt DateTime @default(now()) @map("created_at")

  /// Cascade: a nota fiscal não tem sentido sem a diária a que pertence.
  /// Imutabilidade pós-hash é aplicada na camada de serviço, não no schema —
  /// ver `daily-allowance.service.ts`.
  dailyAllowance DailyAllowance @relation(fields: [dailyAllowanceId], references: [id], onDelete: Cascade)

  @@index([dailyAllowanceId])
  @@map("daily_allowance_receipts")
}

// ─────────────────────────────────────────────────────────────────────────────
// Simplifica Frotas (TASK 2 da spec técnica — docs/frotas/)
//
// Convenções (docs/frotas/decisoes.md):
//   - D2: dinheiro Decimal(15,2), litros Decimal(10,3), preço unitário Decimal(10,4).
//   - PKs cuid; Department.id é nanoid (nunca validar departmentId como uuid).
//   - Soft-delete por deletedAt; unicidade "entre ativos" por índice parcial
//     criado em SQL na migration (o Prisma não expressa índice parcial).
//   - Documentos com QR (autorização, OS, diário de bordo) têm publicId separado
//     da PK e numeração sequencial por organização e ano (padrão das Diárias).
//   - Sem RLS por ora (D11): o isolamento é o filtro por organizationId.
// ─────────────────────────────────────────────────────────────────────────────

enum FleetOwnerKind {
  PREFEITURA
  FUNDO_SAUDE
  FUNDO_EDUCACAO
  FUNDO_ASSISTENCIA
  CAMARA
  AUTARQUIA
  OUTRO
}

enum FleetOwnership {
  PROPRIO
  LOCADO
  CEDIDO
  COMODATO
}

enum FleetVehicleType {
  AUTOMOVEL
  CAMINHONETE
  CAMIONETA
  UTILITARIO
  MOTOCICLETA
  MICROONIBUS
  ONIBUS
  CAMINHAO
  CAMINHAO_TRATOR
  REBOQUE
  MAQUINA
  OUTRO
}

enum FleetFuelType {
  GASOLINA
  ETANOL
  FLEX
  DIESEL_S10
  DIESEL_S500
  GNV
  ELETRICO
  HIBRIDO
}

enum FleetWorkRegime {
  PADRAO_8H
  INTEGRAL_24H
}

enum FleetVehicleStatus {
  EM_USO
  RESERVA
  MANUTENCAO
  ACIDENTADO
  PARALISADO
  A_DOAR
  BAIXADO
}

enum FleetCnhCategory {
  A
  B
  C
  D
  E
  AB
  AC
  AD
  AE
}

enum FleetCnhStatus {
  REGULAR
  SUSPENSA
  CASSADA
  DESCONHECIDA
}

enum FleetEmploymentKind {
  EFETIVO
  COMISSIONADO
  CONTRATADO
  TERCEIRIZADO
}

enum FleetDocStatus {
  PENDING
  ISSUED
}

enum FleetAuthLifecycle {
  OPEN
  IN_USE
  AWAITING_REVIEW
  USED
  CLOSED
  EXPIRED
  BLOCKED
  CANCELLED
}

enum FleetRedeemMode {
  MANUAL
  PHOTO_ONLY
}

enum FleetTripServiceType {
  TRANSPORTE_PACIENTE
  TRANSPORTE_ESCOLAR
  ADMINISTRATIVO
  OBRAS
  FISCALIZACAO
  OUTRO
}

enum FleetTripStatus {
  SOLICITADA
  AUTORIZADA
  EM_CURSO
  CONCLUIDA
  CANCELADA
}

enum FleetServiceOrderKind {
  PREVENTIVA
  PREDITIVA
  CORRETIVA
  ACIDENTE
  BANCADA
  REFORMA
}

enum FleetServiceOrderStatus {
  ABERTA
  ORCADA
  APROVADA
  EM_EXECUCAO
  CONCLUIDA
  CANCELADA
}

enum FleetServiceItemType {
  PECA
  SERVICO
  PNEU
  LUBRIFICANTE
}

enum FleetAlertSeverity {
  INFO
  ALERTA
  BLOQUEIO
}

/// Entidade proprietária (CNPJ em que o veículo está registrado — prefeitura,
/// fundo de saúde, câmara...). Chave das consultas SERPRO na fase 3.
model FleetOwnerEntity {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  name           String
  cnpj           String
  kind           FleetOwnerKind
  createdById    String         @map("created_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User           @relation("FleetOwnerEntityCreator", fields: [createdById], references: [id])
  vehicles     FleetVehicle[]

  // UNIQUE (organization_id, cnpj) WHERE deleted_at IS NULL — índice parcial na migration.
  @@index([organizationId])
  @@map("fleet_owner_entities")
}

model FleetVehicle {
  id              String             @id @default(cuid())
  organizationId  String             @map("organization_id")
  /// Secretaria responsável (nanoid). Apagar o departamento não apaga o veículo.
  departmentId    String?            @map("department_id")
  ownerEntityId   String?            @map("owner_entity_id")
  /// Placa normalizada: AAA0A00 / AAA0000, maiúsculas, sem hífen.
  plate           String
  /// 11 dígitos, DV conferido no servidor.
  renavam         String?
  /// VIN de 17 caracteres, sem I, O, Q.
  chassis         String?
  makeModel       String?            @map("make_model")
  manufactureYear Int?               @map("manufacture_year")
  modelYear       Int?               @map("model_year")
  ownership       FleetOwnership
  vehicleType     FleetVehicleType   @map("vehicle_type")
  fuelType        FleetFuelType      @map("fuel_type")
  usesArla32      Boolean            @default(false) @map("uses_arla32")
  tankCapacityL   Decimal            @map("tank_capacity_l") @db.Decimal(10, 3)
  referenceKmPerL Decimal?           @map("reference_km_per_l") @db.Decimal(5, 2)
  workRegime      FleetWorkRegime    @default(PADRAO_8H) @map("work_regime")
  status          FleetVehicleStatus @default(EM_USO)
  /// Maior hodômetro válido registrado (desnormalizado; só cresce).
  odometerKm      Int                @default(0) @map("odometer_km")
  /// Nº de patrimônio. Obrigatório para PROPRIO (regra no service); único na organização entre ativos.
  assetTag        String?            @map("asset_tag")
  marketValue     Decimal?           @map("market_value") @db.Decimal(15, 2)
  createdById     String             @map("created_by_id") @db.Uuid
  updatedById     String?            @map("updated_by_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  deletedAt       DateTime?          @map("deleted_at")

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department    Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  ownerEntity   FleetOwnerEntity?   @relation(fields: [ownerEntityId], references: [id], onDelete: Restrict)
  createdBy     User                @relation("FleetVehicleCreator", fields: [createdById], references: [id])
  updatedBy     User?               @relation("FleetVehicleUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  fuelings      FleetFueling[]
  trips         FleetTrip[]
  serviceOrders FleetServiceOrder[]
  qualityAlerts FleetQualityAlert[]

  // UNIQUE (organization_id, plate), (organization_id, renavam) e (organization_id, asset_tag) WHERE deleted_at IS NULL — índices parciais na migration.
  @@index([organizationId, status])
  @@index([organizationId, departmentId])
  @@map("fleet_vehicles")
}

/// Motorista. CPF e nº da CNH só cifrados (AES-256-GCM, chave por organização);
/// a busca por CPF usa o blind index (HMAC-SHA-256).
model FleetDriver {
  id                 String              @id @default(cuid())
  organizationId     String              @map("organization_id")
  /// Servidor do SIMP, quando o motorista tem usuário.
  userId             String?             @map("user_id") @db.Uuid
  departmentId       String?             @map("department_id")
  name               String
  /// Matrícula funcional. Obrigatória para EFETIVO e COMISSIONADO (regra no service); única na organização entre ativos.
  registrationNumber String?             @map("registration_number")
  cpfEncrypted       String              @map("cpf_encrypted")
  cpfBlindIndex      String              @map("cpf_blind_index")
  cnhNumberEncrypted String              @map("cnh_number_encrypted")
  cnhCategory        FleetCnhCategory    @map("cnh_category")
  cnhExpiry          DateTime            @map("cnh_expiry") @db.Date
  cnhStatus          FleetCnhStatus      @default(DESCONHECIDA) @map("cnh_status")
  /// Cursos especiais (escolar, emergência, coletivo, produtos perigosos): data e UF.
  specialCourses     Json?               @map("special_courses")
  employmentKind     FleetEmploymentKind @map("employment_kind")
  active             Boolean             @default(true)
  createdById        String              @map("created_by_id") @db.Uuid
  updatedById        String?             @map("updated_by_id") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  deletedAt          DateTime?           @map("deleted_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?          @relation("FleetDriverUser", fields: [userId], references: [id], onDelete: SetNull)
  department   Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdBy    User           @relation("FleetDriverCreator", fields: [createdById], references: [id])
  updatedBy    User?          @relation("FleetDriverUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  fuelings     FleetFueling[]
  trips        FleetTrip[]

  // UNIQUE (organization_id, cpf_blind_index) e (organization_id, registration_number) WHERE deleted_at IS NULL — índices parciais na migration.
  @@index([organizationId, active])
  @@map("fleet_drivers")
}

/// Contrato ou ata (combustível, peças, serviços). Saldo calculado na leitura.
model FleetContract {
  id               String         @id @default(cuid())
  organizationId   String         @map("organization_id")
  number           String
  supplierName     String         @map("supplier_name")
  supplierCnpj     String         @map("supplier_cnpj")
  object           String
  fuelType         FleetFuelType? @map("fuel_type")
  unitPrice        Decimal?       @map("unit_price") @db.Decimal(10, 4)
  totalAmount      Decimal        @map("total_amount") @db.Decimal(15, 2)
  maxVolumeL       Decimal?       @map("max_volume_l") @db.Decimal(10, 3)
  /// Nº do empenho como texto: o SIMP ainda não tem entidade de empenho.
  commitmentNumber String?        @map("commitment_number")
  qddItemId        String?        @map("qdd_item_id")
  startDate        DateTime       @map("start_date") @db.Date
  endDate          DateTime       @map("end_date") @db.Date
  createdById      String         @map("created_by_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  deletedAt        DateTime?      @map("deleted_at")

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  qddItem       QddItem?            @relation(fields: [qddItemId], references: [id], onDelete: Restrict)
  createdBy     User                @relation("FleetContractCreator", fields: [createdById], references: [id])
  fuelings      FleetFueling[]
  serviceOrders FleetServiceOrder[]

  @@index([organizationId, endDate])
  @@map("fleet_contracts")
}

/// Autorização de abastecimento (TASK 3). Recriada do zero sobre o nome do esboço
/// antigo. O documento emitido (PDF + sha256Hash) nunca muda; o que avança depois
/// da emissão é `lifecycle`.
model FleetFueling {
  id                  String             @id @default(cuid())
  publicId            String             @unique @default(uuid()) @map("public_id")
  organizationId      String             @map("organization_id")
  sequenceNumber      Int                @map("sequence_number")
  year                Int
  formattedNumber     String             @map("formatted_number")
  status              FleetDocStatus     @default(PENDING)
  lifecycle           FleetAuthLifecycle @default(OPEN)
  departmentId        String             @map("department_id")
  vehicleId           String             @map("vehicle_id")
  driverId            String             @map("driver_id")
  contractId          String?            @map("contract_id")
  qddItemId           String?            @map("qdd_item_id")
  qddFichaSnapshot    String?            @map("qdd_ficha_snapshot")
  qddFonteSnapshot    String?            @map("qdd_fonte_snapshot")
  qddNaturezaSnapshot String?            @map("qdd_natureza_snapshot")
  fuelType            FleetFuelType      @map("fuel_type")
  maxVolumeL          Decimal            @map("max_volume_l") @db.Decimal(10, 3)
  maxAmount           Decimal            @map("max_amount") @db.Decimal(15, 2)
  unitPriceCap        Decimal            @map("unit_price_cap") @db.Decimal(10, 4)
  validUntil          DateTime           @map("valid_until")
  purpose             String
  /// SHA-256 (hex) do token do QR operacional; o token nunca é gravado.
  redeemTokenHash     String?            @unique @map("redeem_token_hash")
  plateAttempts       Int                @default(0) @map("plate_attempts")
  /// Fim da sessão de 30 min do frentista.
  lockedUntil         DateTime?          @map("locked_until")
  budgetOverrun       Boolean            @default(false) @map("budget_overrun")
  cancelReason        String?            @map("cancel_reason")
  pdfFileKey          String?            @map("pdf_file_key")
  sha256Hash          String?            @map("sha256_hash")
  issuedAt            DateTime?          @map("issued_at")
  issuedById          String?            @map("issued_by_id") @db.Uuid
  createdById         String             @map("created_by_id") @db.Uuid
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  deletedAt           DateTime?          @map("deleted_at")

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department              @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  vehicle      FleetVehicle            @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver       FleetDriver             @relation(fields: [driverId], references: [id], onDelete: Restrict)
  contract     FleetContract?          @relation(fields: [contractId], references: [id], onDelete: Restrict)
  qddItem      QddItem?                @relation(fields: [qddItemId], references: [id], onDelete: Restrict)
  issuedBy     User?                   @relation("FleetFuelingIssuer", fields: [issuedById], references: [id])
  createdBy    User                    @relation("FleetFuelingCreator", fields: [createdById], references: [id])
  redemption   FleetFuelingRedemption?

  @@unique([organizationId, year, sequenceNumber])
  @@index([organizationId, lifecycle, validUntil])
  @@index([organizationId, departmentId])
  @@index([qddItemId])
  @@map("fleet_fuelings")
}

/// Uso único da autorização (rota pública do frentista). O @unique em fuelingId é
/// a garantia de uso único no banco.
model FleetFuelingRedemption {
  id             String          @id @default(cuid())
  organizationId String          @map("organization_id")
  fuelingId      String          @unique @map("fueling_id")
  mode           FleetRedeemMode
  volumeL        Decimal?        @map("volume_l") @db.Decimal(10, 3)
  unitPrice      Decimal?        @map("unit_price") @db.Decimal(10, 4)
  totalAmount    Decimal?        @map("total_amount") @db.Decimal(15, 2)
  odometerKm     Int?            @map("odometer_km")
  /// Chave de 44 dígitos da NFC-e.
  nfceKey        String?         @map("nfce_key")
  submittedAt    DateTime        @default(now()) @map("submitted_at")
  submittedIp    String          @map("submitted_ip")
  userAgent      String          @map("user_agent")
  reviewedById   String?         @map("reviewed_by_id") @db.Uuid
  reviewedAt     DateTime?       @map("reviewed_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fueling      FleetFueling        @relation(fields: [fuelingId], references: [id], onDelete: Restrict)
  reviewedBy   User?               @relation("FleetRedemptionReviewer", fields: [reviewedById], references: [id])
  images       FleetReceiptImage[]

  /// O mesmo cupom fiscal não comprova dois abastecimentos.
  @@unique([organizationId, nfceKey])
  @@map("fleet_fueling_redemptions")
}

model FleetReceiptImage {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  redemptionId   String   @map("redemption_id")
  storageKey     String   @map("storage_key")
  thumbnailKey   String?  @map("thumbnail_key")
  sha256         String
  mimeType       String   @map("mime_type")
  sizeBytes      Int      @map("size_bytes")
  width          Int?
  height         Int?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  redemption   FleetFuelingRedemption @relation(fields: [redemptionId], references: [id], onDelete: Restrict)

  @@index([redemptionId])
  @@map("fleet_receipt_images")
}

/// Viagem (diário de bordo).
model FleetTrip {
  id                    String               @id @default(cuid())
  publicId              String               @unique @default(uuid()) @map("public_id")
  organizationId        String               @map("organization_id")
  sequenceNumber        Int                  @map("sequence_number")
  year                  Int
  formattedNumber       String               @map("formatted_number")
  vehicleId             String               @map("vehicle_id")
  driverId              String?              @map("driver_id")
  requesterDepartmentId String               @map("requester_department_id")
  requesterId           String               @map("requester_id") @db.Uuid
  purpose               String
  origin                String
  destination           String
  serviceType           FleetTripServiceType @map("service_type")
  plannedStart          DateTime             @map("planned_start")
  plannedEnd            DateTime             @map("planned_end")
  startAt               DateTime?            @map("start_at")
  endAt                 DateTime?            @map("end_at")
  startOdometer         Int?                 @map("start_odometer")
  endOdometer           Int?                 @map("end_odometer")
  passengers            Json?
  status                FleetTripStatus      @default(SOLICITADA)
  approvedById          String?              @map("approved_by_id") @db.Uuid
  approvedAt            DateTime?            @map("approved_at")
  cancelReason          String?              @map("cancel_reason")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")
  deletedAt             DateTime?            @map("deleted_at")

  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle             FleetVehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver              FleetDriver? @relation(fields: [driverId], references: [id], onDelete: Restrict)
  requesterDepartment Department   @relation(fields: [requesterDepartmentId], references: [id], onDelete: Restrict)
  requester           User         @relation("FleetTripRequester", fields: [requesterId], references: [id])
  approvedBy          User?        @relation("FleetTripApprover", fields: [approvedById], references: [id])

  @@unique([organizationId, year, sequenceNumber])
  @@index([organizationId, status])
  @@index([vehicleId, startAt])
  @@map("fleet_trips")
}

/// Ordem de serviço de manutenção.
model FleetServiceOrder {
  id                  String                  @id @default(cuid())
  publicId            String                  @unique @default(uuid()) @map("public_id")
  organizationId      String                  @map("organization_id")
  sequenceNumber      Int                     @map("sequence_number")
  year                Int
  formattedNumber     String                  @map("formatted_number")
  vehicleId           String                  @map("vehicle_id")
  kind                FleetServiceOrderKind
  workshopName        String?                 @map("workshop_name")
  workshopCnpj        String?                 @map("workshop_cnpj")
  contractId          String?                 @map("contract_id")
  qddItemId           String?                 @map("qdd_item_id")
  qddFichaSnapshot    String?                 @map("qdd_ficha_snapshot")
  qddFonteSnapshot    String?                 @map("qdd_fonte_snapshot")
  qddNaturezaSnapshot String?                 @map("qdd_natureza_snapshot")
  openedAt            DateTime                @map("opened_at") @db.Date
  closedAt            DateTime?               @map("closed_at") @db.Date
  odometerKm          Int?                    @map("odometer_km")
  diagnosis           String
  invoiceNumber       String?                 @map("invoice_number")
  /// Chave de 44 dígitos da NF-e.
  invoiceKey          String?                 @map("invoice_key")
  totalAmount         Decimal                 @default(0) @map("total_amount") @db.Decimal(15, 2)
  status              FleetServiceOrderStatus @default(ABERTA)
  budgetOverrun       Boolean                 @default(false) @map("budget_overrun")
  createdById         String                  @map("created_by_id") @db.Uuid
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")
  deletedAt           DateTime?               @map("deleted_at")

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle      FleetVehicle            @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  contract     FleetContract?          @relation(fields: [contractId], references: [id], onDelete: Restrict)
  qddItem      QddItem?                @relation(fields: [qddItemId], references: [id], onDelete: Restrict)
  createdBy    User                    @relation("FleetServiceOrderCreator", fields: [createdById], references: [id])
  items        FleetServiceOrderItem[]

  @@unique([organizationId, year, sequenceNumber])
  @@index([organizationId, status])
  @@index([qddItemId])
  @@map("fleet_service_orders")
}

model FleetServiceOrderItem {
  id             String               @id @default(cuid())
  organizationId String               @map("organization_id")
  serviceOrderId String               @map("service_order_id")
  itemType       FleetServiceItemType @map("item_type")
  description    String
  partCode       String?              @map("part_code")
  quantity       Decimal              @db.Decimal(10, 3)
  unitPrice      Decimal              @map("unit_price") @db.Decimal(10, 4)
  total          Decimal              @db.Decimal(15, 2)
  warrantyMonths Int?                 @map("warranty_months")
  warrantyKm     Int?                 @map("warranty_km")
  createdAt      DateTime             @default(now()) @map("created_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceOrder FleetServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([serviceOrderId])
  @@map("fleet_service_order_items")
}

/// Alerta de qualidade de dados (regras GFI): registra, não bloqueia por si.
model FleetQualityAlert {
  id             String             @id @default(cuid())
  organizationId String             @map("organization_id")
  vehicleId      String?            @map("vehicle_id")
  type           String
  severity       FleetAlertSeverity
  entityType     String             @map("entity_type")
  entityId       String             @map("entity_id")
  message        String
  details        Json?
  resolvedAt     DateTime?          @map("resolved_at")
  resolvedById   String?            @map("resolved_by_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle      FleetVehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  resolvedBy   User?         @relation("FleetAlertResolver", fields: [resolvedById], references: [id])

  @@index([organizationId, resolvedAt])
  @@map("fleet_quality_alerts")
}

// ─────────────────────────────────────────────────────────────────────────────
// Cadastro de beneficiários de diárias (correção de regra de negócio)
// ─────────────────────────────────────────────────────────────────────────────

model Beneficiary {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")

  // Sempre em CAIXA ALTA, normalizado pelo serviço antes de gravar. Sem isso
  // "joão silva" e "João Silva" criariam duas entradas para a mesma pessoa e a
  // restrição de unicidade abaixo não teria efeito prático.
  name String

  /// CPF apenas em dígitos, sem máscara — a formatação é apresentação.
  /// Opcional: beneficiários já cadastrados não o possuem.
  cpf String?

  /// Setor de lotação. Alimenta o preenchimento automático do departamento no
  /// formulário de diária — é SUGESTÃO, não trava: servidor cedido viaja a
  /// serviço de outra pasta, e a despesa corre por quem a autorizou.
  departmentId String? @map("department_id")

  /// Dados de registro do servidor — Anexo I (Épico 4). Vivem aqui para serem
  /// reaproveitados via autocomplete a cada nova diária, e são copiados como
  /// TEXTO para a diária no instante da criação: o mesmo motivo de
  /// `beneficiaryName` não ser chave estrangeira — corrigir o cadastro depois
  /// não pode reescrever um documento já emitido.
  registrationNumber String? @map("registration_number")
  /// RG e órgão expedidor num campo só, como no formulário físico
  /// ("32000002 SSP/GO") — o papel trata como uma célula única.
  rg                 String?
  jobTitle           String? @map("job_title")
  /// Lotação real do servidor (ex: um FUNDO específico) — DISTINTA do
  /// `departmentId` acima, que é o órgão CONCEDENTE da diária. Na prática
  /// municipal as duas frequentemente não coincidem.
  lotacao            String?
  bankName           String? @map("bank_name")
  bankAgency         String? @map("bank_agency")
  bankAccount        String? @map("bank_account")

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // Unicidade POR ORGANIZAÇÃO: duas prefeituras podem ter servidores homônimos,
  // e uma restrição global impediria a segunda de cadastrar o seu.
  @@unique([name, organizationId])
  /// Unicidade POR ORGANIZAÇÃO, não global: a mesma pessoa pode ser beneficiária
  /// em duas prefeituras, e um índice global impediria a segunda de cadastrá-la
  /// — além de revelar, pela recusa, que ela já existe em outro tenant.
  @@unique([cpf, organizationId])
  @@index([organizationId])
  @@map("beneficiaries")
}

// ─────────────────────────────────────────────────────────────────────────────
// Registro de documentos exportados — validação universal
// ─────────────────────────────────────────────────────────────────────────────

model ExportedDocument {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")

  // Identificador público impresso no QR Code. Separado da chave primária pelo
  // mesmo motivo dos demais documentos: o PK nunca vai para a internet.
  publicId String @unique @default(uuid()) @map("public_id")

  // Tipo do documento exportado: REPORT_PROTOCOLS, COUNCIL_CALENDAR, etc.
  // String livre, e não enum, porque a promessa é validar QUALQUER PDF futuro do
  // sistema — um enum exigiria migração a cada relatório novo. Os rótulos em
  // pt-BR para o portal ficam em constants/exported-document-types.ts.
  documentType String @map("document_type")

  // SHA-256 dos bytes finais do PDF. É o que permite a um terceiro conferir o
  // arquivo que tem em mãos contra o que o portal afirma.
  sha256Hash String @map("sha256_hash")

  // Nome de quem exportou, JÁ OFUSCADO (ver utils/lgpd-anonymizer.util.ts).
  // Guardado mascarado, e não mascarado na leitura: o registro alimenta um
  // endpoint público, e dado pessoal que nunca entra no banco não pode vazar
  // dele por descuido de uma consulta futura.
  exporterName String @map("exporter_name")

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, documentType])
  @@map("exported_documents")
}

// ─────────────────────────────────────────────────────────────────────────────
// Épico 4 — Departamentos, Motor Orçamentário (QDD) e Diárias
// ─────────────────────────────────────────────────────────────────────────────

/// Situação da diária ao longo do fluxo.
enum DailyAllowanceStatus {
  PENDING
  ISSUED
  ACCOUNTED
}

/// Tipo da lei orçamentária.
/// Meio de transporte declarado na diária — mesmas opções do formulário físico.
enum TransportMeans {
  RODOVIARIO
  AEREO
  VEICULO_OFICIAL
  OUTRO
}

/// Origem do recurso que cobre a diária.
enum FundingSource {
  PROPRIO
  CONVENIO
}

enum BudgetLawType {
  LOA
  PPA
  LDO
}

// ─────────────────────────────────────────────────────────────────────────────
// Épico 8 — Motor Orçamentário, Prestação de Contas e Controle Financeiro
// ─────────────────────────────────────────────────────────────────────────────

/// Fase oficial da despesa pública (Lei 4.320/64). Dimensão ADICIONAL ao
/// `status` textual de `VirtualProcess` — não o substitui (Épico 8, FR-019).
enum ExpensePhase {
  EMPENHO
  LIQUIDACAO
  PAGAMENTO
}

/// Abrangência do feriado — usada só para organização visual; a regra de
/// bloqueio de diária (Épico 8, FR-021) trata todo feriado cadastrado da
/// mesma forma, independente da abrangência.
enum HolidayScope {
  NATIONAL
  STATE
  MUNICIPAL
}

/// Feriado cadastrável por organização — a regra do TCE que exige
/// justificativa de diária em fim de semana/feriado (Épico 8, FR-020 a
/// FR-022) depende dele para a parte municipal, que nenhuma biblioteca
/// genérica de feriados nacionais cobre.
model Holiday {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")

  date  DateTime     @db.Date
  name  String
  scope HolidayScope @default(MUNICIPAL)

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, date])
  @@index([organizationId, date])
  @@map("holidays")
}

/// Rastro de suplementação/redução do valor orçado de uma ficha do QDD
/// (Épico 8, FR-013) — o achado que reprova uma prestação de contas
/// municipal quando ausente. Um registro por alteração; nunca editado nem
/// apagado.
model BudgetHistory {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  qddItemId      String @map("qdd_item_id")

  /// Valor orçado antes da alteração.
  previousValue Decimal  @map("previous_value") @db.Decimal(15, 2)
  /// Valor orçado depois da alteração.
  newValue      Decimal  @map("new_value") @db.Decimal(15, 2)
  /// Variação percentual de `previousValue` para `newValue`. Nulo quando
  /// `previousValue` é zero — percentual sobre base zero não tem significado.
  changePercent Decimal? @map("change_percent") @db.Decimal(7, 2)

  /// Motivo da suplementação/redução. Nunca vazio — obrigatório na camada de
  /// serviço, não apenas convenção de UI.
  reason String @db.Text

  changedById String @map("changed_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  qddItem      QddItem      @relation(fields: [qddItemId], references: [id], onDelete: Cascade)
  changedBy    User         @relation(fields: [changedById], references: [id])

  @@index([organizationId, qddItemId])
  @@map("budget_histories")
}

/// Vínculo N:N entre Conselho e Departamento.
model CouncilDepartment {
  id             String @id @default(nanoid())
  organizationId String @map("organization_id")
  councilId      String @map("council_id")
  departmentId   String @map("department_id")

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  council      Council      @relation(fields: [councilId], references: [id], onDelete: Cascade)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([councilId, departmentId])
  @@index([organizationId])
  @@map("council_departments")
}

/// Lei orçamentária de um setor num exercício (LOA, PPA, LDO).
model BudgetLaw {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  departmentId   String @map("department_id")

  type BudgetLawType
  year Int

  /// Número/ano da lei, ex: "1.234/2026". Texto e não numérico: leis municipais
  /// costumam ter sufixo ou formatação própria que um Int não comportaria.
  lawNumber   String?   @map("law_number")
  /// Data de publicação — é o marco que o Tribunal de Contas confere.
  publishedAt DateTime? @map("published_at")
  details     String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  /// Um LOA, um PPA e um LDO por setor e exercício. Suplementação ou emenda
  /// atualiza o registro existente — não cria um segundo.
  @@unique([departmentId, type, year])
  @@index([organizationId, departmentId, year])
  @@map("budget_laws")
}

/// Ficha do Quadro de Detalhamento da Despesa — a dotação que lastreia a despesa.
///
/// NOMES EM PORTUGUÊS de propósito: `ficha`, `fonte`, `projetoAtividade` e
/// `naturezaDespesa` são termos do orçamento público brasileiro sem equivalente
/// direto em inglês, no mesmo precedente de `empenho` e `liquidação` já aceitos
/// na Constituição (Princípio III). Traduzi-los tornaria o campo irreconhecível
/// para quem opera o orçamento.
model QddItem {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  departmentId   String @map("department_id")

  year  Int
  ficha String
  fonte String

  projetoAtividade String @map("projeto_atividade")
  naturezaDespesa  String @map("natureza_despesa")

  /// Decimal, nunca Float: é dotação de dinheiro público.
  valorOrcado Decimal @map("valor_orcado") @db.Decimal(15, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department         Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  dailyAllowances    DailyAllowance[]
  virtualProcesses   VirtualProcess[]
  covenants          Covenant[]
  fleetContracts     FleetContract[]
  fleetFuelings      FleetFueling[]
  fleetServiceOrders FleetServiceOrder[]
  /// Rastro de suplementação/redução de `valorOrcado` — nunca editado nem
  /// apagado, só acrescido (Épico 8, FR-013).
  history            BudgetHistory[]

  /// Duas fichas iguais no mesmo setor e exercício tornariam ambíguo a qual
  /// dotação a despesa foi imputada.
  @@unique([departmentId, year, ficha])
  @@index([organizationId, year])
  @@map("qdd_items")
}
