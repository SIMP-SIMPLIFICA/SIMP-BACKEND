generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [unaccent]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  cnpj      String?  @unique
  plan      String   @default("basic")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                  User[]
  roles                  Role[]
  departments            Department[]
  workspaces             Workspace[]
  communicationDocuments CommunicationDocument[]
  notes                  Note[]
  calendarEvents         CalendarEvent[]
  auditLogs              AuditLog[]
  settings               Setting[]
  notifications          Notification[]
  bankAccounts           BankAccount[]
  financeCategories      FinanceCategory[]
  financeEntries         FinanceEntry[]
  virtualProcesses       VirtualProcess[]
  virtualProcessCategories VirtualProcessCategory[]
  virtualProcessSources  VirtualProcessSource[]
  virtualProcessCompanies VirtualProcessCompany[]
  modules                OrganizationModule[]
  libraryDocuments       LibraryDocument[]
  documentCategories     DocumentCategory[]

  @@map("organizations")
}

model OrganizationModule {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  module         String
  isEnabled      Boolean  @default(true) @map("is_enabled")
  enabledById    String?  @map("enabled_by_id")
  notes          String?
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, module])
  @@index([organizationId])
  @@map("organization_modules")
}

model User {
  id                   String    @id @default(nanoid())
  email                String    @unique
  username             String?   @unique
  firstName            String?
  lastName             String?
  avatar               String?
  password             String
  jobTitle             String?   @map("job_title")
  isActive             Boolean   @default(false)
  isVerified           Boolean   @default(false)
  verifyToken          String?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  lastLoginAt          DateTime?
  twoFactorEnabled     Boolean   @default(false)
  twoFactorSecret      String?
  backupCodes          String[]
  metadata             Json?
  preferences          Json?
  isSuperAdmin         Boolean   @default(false) @map("is_super_admin")
  emailNotifications   Boolean   @default(true)  @map("email_notifications")
  autoClearDays        Int       @default(30)     @map("auto_clear_days")
  clearanceLevel       Int       @default(1)      @map("clearance_level")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])

  auditLogs AuditLog[]
  roles     UserRole[]
  sessions  UserSession[]

  workspaceMemberships WorkspaceMember[]
  createdTasks         Task[]            @relation("TaskCreator")
  assignedTasks        TaskAssignee[]
  taskNotes            TaskNote[]
  taskHistory          TaskHistory[]
  notifications        Notification[]

  createdDocuments   CommunicationDocument[] @relation("DocumentCreator")
  documentRecipients DocumentRecipient[]

  calendarEvents     CalendarEvent[]
  notes              Note[]

  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId String?

  // --- RELAÇÕES FINANCEIRAS ---
  createdFinanceEntries FinanceEntry[]      @relation("FinanceEntryCreator")
  updatedFinanceEntries FinanceEntry[]      @relation("FinanceEntryUpdater")
  financeAttachments    FinanceAttachment[]

  createdProcesses         VirtualProcess[]         @relation("ProcessCreator")
  uploadedProcessDocuments VirtualProcessDocument[] @relation("ProcessDocumentUploader")

  uploadedLibraryDocs      LibraryDocument[]        @relation("LibraryDocumentUploader")

  @@map("users")
}

model Role {
  id          String   @id @default(nanoid())
  name        String   @unique
  displayName String
  description String?
  color       String?
  permissions Json
  parentId    String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])

  parent   Role?      @relation("RoleHierarchy", fields: [parentId], references: [id])
  children Role[]     @relation("RoleHierarchy")
  users    UserRole[]

  @@map("roles")
}

model UserRole {
  id         String    @id @default(nanoid())
  userId     String
  roleId     String
  expiresAt  DateTime?
  assignedBy String?
  assignedAt DateTime  @default(now())
  metadata   Json?

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model UserSession {
  id           String   @id @default(nanoid())
  userId       String
  refreshToken String   @unique
  fingerprint  String?
  ipAddress    String?
  userAgent    String?
  isActive     Boolean  @default(true)
  lastUsedAt   DateTime @default(now())
  expiresAt    DateTime
  deviceType   String?
  deviceName   String?
  location     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model AuditLog {
  id           String   @id @default(nanoid())
  userId       String?
  action       String
  resource     String
  resourceId   String?
  method       String?
  endpoint     String?
  ipAddress    String
  userAgent    String?
  oldData      Json?
  newData      Json?
  metadata     Json?
  success      Boolean
  errorMessage String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

model RevokedToken {
  id        String   @id @default(nanoid())
  jti       String   @unique
  userId    String?
  reason    String?
  revokedAt DateTime @default(now())
  expiresAt DateTime

  @@index([jti])
  @@index([expiresAt])
  @@map("revoked_tokens")
}

model Setting {
  id          String   @id @default(nanoid())
  key         String   @unique
  value       Json
  type        String
  description String?
  isPublic    Boolean  @default(false)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@map("settings")
}

model Department {
  id          String   @id @default(nanoid())
  name        String
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])

  users User[]

  @@map("departments")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  EXPIRED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Workspace {
  id          String   @id @default(uuid())
  name        String
  description String?
  slug        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])

  members WorkspaceMember[]
  tasks   Task[]
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Task {
  id          String       @id @default(uuid())
  code        Int          @default(autoincrement())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?

  workspaceId String
  creatorId   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator   User      @relation("TaskCreator", fields: [creatorId], references: [id])

  assignees   TaskAssignee[]
  checklist   ChecklistItem[]
  attachments TaskAttachment[]
  notes       TaskNote[]
  history     TaskHistory[]
}

model TaskAssignee {
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
}

model ChecklistItem {
  id     String  @id @default(uuid())
  title  String
  isDone Boolean @default(false)
  taskId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskAttachment {
  id         String   @id @default(uuid())
  fileName   String
  fileUrl    String
  fileType   String
  fileSize   Int
  uploadedAt DateTime @default(now())
  taskId     String
  uploaderId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskNote {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  taskId    String
  authorId  String

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])
}

model TaskHistory {
  id        String   @id @default(uuid())
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
  taskId    String
  userId    String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  userId    String
  read      Boolean  @default(false)
  type      String
  link      String?
  entityId  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

enum DocumentStatus {
  DRAFT
  SENT
  READ
  ARCHIVED
}

enum DocumentRole {
  TO
  CC
  BCC
}

model CommunicationDocument {
  id      String         @id @default(nanoid())
  title   String         @db.VarChar(500)
  content String         @db.Text
  status  DocumentStatus @default(DRAFT)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  sentAt    DateTime? @map("sent_at")
  readAt    DateTime? @map("read_at")

  createdBy String @map("created_by")
  creator   User   @relation("DocumentCreator", fields: [createdBy], references: [id])

  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])

  recipients  DocumentRecipient[]
  attachments CommunicationAttachment[]

  @@map("communication_documents")
}

model DocumentRecipient {
  id         String       @id @default(nanoid())
  documentId String       @map("document_id")
  userId     String       @map("user_id")
  role       DocumentRole @default(TO)
  canView    Boolean      @default(true) @map("can_view")
  readAt     DateTime?    @map("read_at")

  document CommunicationDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User                  @relation(fields: [userId], references: [id])

  @@map("document_recipients")
}


model CommunicationAttachment {
  id         String @id @default(nanoid())
  documentId String @map("document_id")
  fileName   String @map("file_name")
  fileUrl    String @map("file_url")
  fileType   String @map("file_type")
  fileSize   Int    @map("file_size")

  uploadedAt DateTime @default(now()) @map("uploaded_at")

  document CommunicationDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("communication_attachments")
}


enum FinanceEntryType {
  EXPENSE
  INCOME
}

model BankAccount {
  id                  String   @id @default(uuid())
  organizationId      String   @map("organization_id")
  name                String
  agency              String?
  accountNumber       String?
  initialBalanceCents Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries      FinanceEntry[]

  @@map("bank_accounts")
}

model FinanceCategory {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries      FinanceEntry[]

  @@unique([organizationId, name])
  @@map("finance_categories")
}

model FinanceEntry {
  id                String           @id @default(uuid())
  organizationId    String           @map("organization_id")
  occurredAt        DateTime
  description       String
  amountCents       Int
  type              FinanceEntryType @default(EXPENSE)
  categoryId        String?
  accountId         String?
  subcategoryName   String?
  nfeNumber         String?
  issueDate         DateTime?
  providerDocument  String? // CPF/CNPJ
  empenhoNumber     String?
  liquidacaoNumber  String?
  deliveryDate      DateTime?
  attachmentsStatus String           @default("none")
  createdById       String
  updatedById       String?
  deletedAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  attachments  FinanceAttachment[]
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     FinanceCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account      BankAccount?        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdBy    User                @relation("FinanceEntryCreator", fields: [createdById], references: [id])
  updatedBy    User?               @relation("FinanceEntryUpdater", fields: [updatedById], references: [id])

  @@index([organizationId, occurredAt])
  @@index([categoryId])
  @@index([accountId])
  @@map("finance_entries")
}

model FinanceAttachment {
  id         String   @id @default(uuid())
  entryId    String
  uploaderId String
  fileName   String
  fileType   String
  fileSize   Int
  fileUrl    String
  createdAt  DateTime @default(now())

  entry    FinanceEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  uploader User         @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@map("finance_attachments")
}

model VirtualProcess {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  processNumber  String    @map("process_number")
  secretaria     String
  source         String
  sourceDetail   String?   @map("source_detail")
  bankAccount    String?   @map("bank_account")
  agency         String?
  bankName       String?   @map("bank_name")
  companyCnpj    String?   @map("company_cnpj")
  companyName    String?   @map("company_name")
  startDate      DateTime? @map("start_date")
  endDate        DateTime? @map("end_date")
  subject        String    @db.Text
  status         String    @default("Tramitando")
  category       String    @default("Outros")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String   @map("created_by_id")

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      User                     @relation("ProcessCreator", fields: [createdById], references: [id])
  documents    VirtualProcessDocument[]

  @@unique([organizationId, processNumber])
  @@map("virtual_processes")
}

model VirtualProcessCategory {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@map("virtual_process_categories")
}

model VirtualProcessSource {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@map("virtual_process_sources")
}

model VirtualProcessCompany {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  cnpj           String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@map("virtual_process_companies")
}

model VirtualProcessDocument {
  id               String   @id @default(uuid())
  virtualProcessId String   @map("virtual_process_id")
  tag              String
  description      String?
  fileName         String   @map("file_name")
  fileUrl          String   @map("file_url")
  fileSize         Int      @map("file_size")
  uploadedById     String   @map("uploaded_by_id")
  uploadedAt       DateTime @default(now()) @map("uploaded_at")

  process  VirtualProcess @relation(fields: [virtualProcessId], references: [id], onDelete: Cascade)
  uploader User           @relation("ProcessDocumentUploader", fields: [uploadedById], references: [id])

  @@map("virtual_process_documents")
}

model CalendarEvent {
  id          String    @id @default(nanoid())
  title       String
  description String?   @db.Text
  startAt     DateTime  @map("start_at")
  endAt       DateTime? @map("end_at")
  allDay      Boolean   @default(false) @map("all_day")
  color       String    @default("#3B82F6")
  location    String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])

  attachments CalendarAttachment[]

  @@index([userId, startAt])
  @@map("calendar_events")
}

model CalendarAttachment {
  id         String @id @default(nanoid())
  eventId    String @map("event_id")
  fileName   String @map("file_name")
  fileUrl    String @map("file_url")
  fileType   String @map("file_type")
  fileSize   Int    @map("file_size")

  uploadedAt DateTime @default(now()) @map("uploaded_at")

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("calendar_attachments")
}

model Note {
  id        String   @id @default(nanoid())
  title     String?  @db.VarChar(255)
  content   String   @db.Text
  color     String   @default("#fef08a")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@map("notes")
}

// ─── Biblioteca Digital (GED) ────────────────────────────────────────────────

model LibraryDocument {
  id           String    @id @default(nanoid())
  title        String    @db.VarChar(500)
  fileName     String    @map("file_name")
  fileKey      String    @map("file_key")          // chave no R2: organizations/{orgId}/library/{name}
  fileSize     Int       @map("file_size")          // bytes
  mimeType     String    @default("application/pdf") @map("mime_type")
  accessLevel  Int       @default(1)                @map("access_level") // 1 | 2 | 3
  textContent  String?   @db.Text                   @map("text_content") // OCR para busca profunda

  uploaderId     String   @map("uploader_id")
  organizationId String   @map("organization_id")
  categoryId     String?  @map("category_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")
  deletedAt DateTime?                 @map("deleted_at")

  uploader     User              @relation("LibraryDocumentUploader", fields: [uploaderId], references: [id])
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     DocumentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([organizationId, accessLevel])
  @@index([organizationId, deletedAt])
  @@index([uploaderId])
  @@index([categoryId])
  @@map("library_documents")
}

model DocumentCategory {
  id             String   @id @default(nanoid())
  name           String
  organizationId String   @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt      @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents    LibraryDocument[]

  @@unique([organizationId, name])
  @@map("document_categories")
}
