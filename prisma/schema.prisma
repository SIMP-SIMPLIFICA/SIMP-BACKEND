generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- MODELOS DE AUTENTICAÇÃO E SISTEMA (EXISTENTES) ---

model User {
  id                   String    @id @default(nanoid())
  email                String    @unique
  username             String?   @unique
  firstName            String?
  lastName             String?
  avatar               String?
  password             String
  isActive             Boolean   @default(false)
  isVerified           Boolean   @default(false)
  verifyToken          String?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  lastLoginAt          DateTime?
  twoFactorEnabled     Boolean   @default(false)
  twoFactorSecret      String?
  backupCodes          String[]
  metadata             Json?
  preferences          Json?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relações existentes
  auditLogs AuditLog[]
  roles     UserRole[]
  sessions  UserSession[]

  // --- NOVAS RELAÇÕES (WORKSPACES & TASKS) ---
  workspaceMemberships WorkspaceMember[]
  createdTasks         Task[]            @relation("TaskCreator")
  assignedTasks        TaskAssignee[]
  taskNotes            TaskNote[]
  taskHistory          TaskHistory[]
  notifications        Notification[]

  // --- RELAÇÕES FINANCEIRAS ---
  createdFinanceEntries FinanceEntry[] @relation("FinanceEntryCreator")
  updatedFinanceEntries FinanceEntry[] @relation("FinanceEntryUpdater")

  @@map("users")
}

model Role {
  id          String   @id @default(nanoid())
  name        String   @unique
  displayName String
  description String?
  color       String?
  permissions Json
  parentId    String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Role?      @relation("RoleHierarchy", fields: [parentId], references: [id])
  children Role[]     @relation("RoleHierarchy")
  users    UserRole[]

  @@map("roles")
}

model UserRole {
  id         String    @id @default(nanoid())
  userId     String
  roleId     String
  expiresAt  DateTime?
  assignedBy String?
  assignedAt DateTime  @default(now())
  metadata   Json?

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model UserSession {
  id           String   @id @default(nanoid())
  userId       String
  refreshToken String   @unique
  fingerprint  String?
  ipAddress    String?
  userAgent    String?
  isActive     Boolean  @default(true)
  lastUsedAt   DateTime @default(now())
  expiresAt    DateTime
  deviceType   String?
  deviceName   String?
  location     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model AuditLog {
  id           String   @id @default(nanoid())
  userId       String?
  action       String
  resource     String
  resourceId   String?
  method       String?
  endpoint     String?
  ipAddress    String
  userAgent    String?
  oldData      Json?
  newData      Json?
  metadata     Json?
  success      Boolean
  errorMessage String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

model RevokedToken {
  id        String   @id @default(nanoid())
  jti       String   @unique
  userId    String?
  reason    String?
  revokedAt DateTime @default(now())
  expiresAt DateTime

  @@index([jti])
  @@index([expiresAt])
  @@map("revoked_tokens")
}

model Setting {
  id          String   @id @default(nanoid())
  key         String   @unique
  value       Json
  type        String
  description String?
  isPublic    Boolean  @default(false)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

// --- NOVOS MODELOS DE GESTÃO (WORKSPACES E TASKS) ---

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Workspace {
  id          String   @id @default(uuid())
  name        String
  description String?
  slug        String   @unique // Para URLs amigáveis
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relações
  members           WorkspaceMember[]
  tasks             Task[]
  financeCategories FinanceCategory[]
  financeEntries    FinanceEntry[]
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Task {
  id          String       @id @default(uuid())
  code        Int          @default(autoincrement()) // Ex: T-1, T-2 (Visual)
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?

  workspaceId String
  creatorId   String // ID do usuário que criou

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator   User      @relation("TaskCreator", fields: [creatorId], references: [id])

  assignees   TaskAssignee[]
  checklist   ChecklistItem[]
  attachments TaskAttachment[]
  notes       TaskNote[]
  history     TaskHistory[]
}

model TaskAssignee {
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
}

model ChecklistItem {
  id     String  @id @default(uuid())
  title  String
  isDone Boolean @default(false)
  taskId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskAttachment {
  id         String   @id @default(uuid())
  fileName   String
  fileUrl    String
  fileType   String
  fileSize   Int
  uploadedAt DateTime @default(now())
  taskId     String
  uploaderId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskNote {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  taskId    String
  authorId  String

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])
}

model TaskHistory {
  id        String   @id @default(uuid())
  action    String // Ex: "Mudou status para FEITO"
  metadata  Json? // Dados antigos/novos
  createdAt DateTime @default(now())
  taskId    String
  userId    String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  userId    String // Destinatário
  read      Boolean  @default(false)
  type      String // Ex: TASK_ASSIGNED, MENTION
  link      String? // Link para o recurso
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- MODELOS FINANCEIROS (MVP) ---

enum FinanceEntryType {
  EXPENSE
  INCOME
}

model FinanceCategory {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  financeEntries FinanceEntry[] @relation("CategoryEntries")

  @@unique([workspaceId, name])
  @@map("finance_categories")
}

model FinanceEntry {
  id                String           @id @default(uuid())
  workspaceId       String
  occurredAt        DateTime
  description       String
  amountCents       Int
  type              FinanceEntryType @default(EXPENSE)
  categoryId        String?
  attachmentsStatus String           @default("none")
  createdById       String
  updatedById       String?
  deletedAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category    FinanceCategory?    @relation("CategoryEntries", fields: [categoryId], references: [id])
  createdBy   User                @relation("FinanceEntryCreator", fields: [createdById], references: [id])
  updatedBy   User?               @relation("FinanceEntryUpdater", fields: [updatedById], references: [id])
  attachments FinanceAttachment[] @relation("EntryAttachments")

  @@index([workspaceId, occurredAt])
  @@index([categoryId])
  @@map("finance_entries")
}

model FinanceAttachment {
  id          String   @id @default(uuid())
  entryId     String
  fileName    String
  fileKey     String // R2 unique path
  fileSize    Int
  contentType String
  createdAt   DateTime @default(now())

  entry FinanceEntry @relation("EntryAttachments", fields: [entryId], references: [id])

  @@index([entryId])
}
