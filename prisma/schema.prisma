enum CovenantStatus {
  EM_ANALISE
  APROVADO
  EM_EXECUCAO
  PRESTACAO_CONTAS
  CONCLUIDO
  DEVOLVIDO
}

model Covenant {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  /// Setor responsável. Opcional: o vínculo é informativo e nem todo registro
  /// histórico tem setor identificado.
  departmentId   String? @map("department_id")
  number         String

  typeId       String? @map("type_id")
  proponentId  String? @map("proponent_id")
  convenenteId String? @map("convenente_id")
  concedenteId String? @map("concedente_id")

  processObject   String  @map("process_object") @db.Text
  /// Texto livre legado — mantido como está (Fase 3, 2026-09-24). A partir
  /// desta fase, o vínculo orçamentário DE VERDADE passa a ser `qddItemId`
  /// abaixo; este campo continua existindo só para não invalidar convênios
  /// já cadastrados antes dele existir.
  budgetaryAction String? @map("budgetary_action")

  /// Dotação orçamentária (ficha do QDD) que lastreia o convênio — mesmo
  /// padrão já usado em VirtualProcess.qddItemId e DailyAllowance.qddItemId
  /// (Épico 8, FR-011).
  qddItemId String? @map("qdd_item_id")

  /// CÓPIA TEXTUAL da dotação no instante do vínculo — mesmo motivo de
  /// VirtualProcess.qddFichaSnapshot: o convênio não pode mudar de dotação
  /// retroativamente só porque o cadastro do QDD mudou depois.
  qddFichaSnapshot    String? @map("qdd_ficha_snapshot")
  qddFonteSnapshot    String? @map("qdd_fonte_snapshot")
  qddNaturezaSnapshot String? @map("qdd_natureza_snapshot")

  executionStartDate DateTime? @map("execution_start_date")
  validityStartDate  DateTime? @map("validity_start_date")
  validityEndDate    DateTime? @map("validity_end_date")
  termDays           Int?      @map("term_days")

  transferValue    Decimal? @map("transfer_value") @db.Decimal(15, 2)
  counterpartValue Decimal? @map("counterpart_value") @db.Decimal(15, 2)

  status CovenantStatus @default(EM_ANALISE)

  bankName    String? @map("bank_name")
  bankAgency  String? @map("bank_agency")
  bankAccount String? @map("bank_account")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// SetNull: excluir um setor NÃO pode apagar convênio nem processo — são
  /// registros com valor próprio, não dependentes do setor.
  department       Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  covenantType     CovenantType?          @relation(fields: [typeId], references: [id], onDelete: SetNull)
  proponent        VirtualProcessCompany? @relation(fields: [proponentId], references: [id], onDelete: SetNull)
  convenente       Convenente?            @relation(fields: [convenenteId], references: [id], onDelete: SetNull)
  concedente       Concedente?            @relation(fields: [concedenteId], references: [id], onDelete: SetNull)
  virtualProcesses VirtualProcess[]
  libraryDocuments LibraryDocument[]
  /// Restrict: apagar uma dotação usada por convênio vinculado apagaria o
  /// lastro de uma transferência já documentada (mesma regra de VirtualProcess).
  qddItem          QddItem?               @relation(fields: [qddItemId], references: [id], onDelete: Restrict)

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, typeId])
  @@index([qddItemId])
  @@map("covenants")
}

