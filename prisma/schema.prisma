generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(nanoid())
  email                String    @unique
  username             String?   @unique
  firstName            String?
  lastName             String?
  avatar               String?
  password             String
  jobTitle             String?   @map("job_title")
  isActive             Boolean   @default(false)
  isVerified           Boolean   @default(false)
  verifyToken          String?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  lastLoginAt          DateTime?
  twoFactorEnabled     Boolean   @default(false)
  twoFactorSecret      String?
  backupCodes          String[]
  metadata             Json?
  preferences          Json?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  auditLogs AuditLog[]
  roles     UserRole[]
  sessions  UserSession[]

  workspaceMemberships WorkspaceMember[]
  createdTasks         Task[]            @relation("TaskCreator")
  assignedTasks        TaskAssignee[]
  taskNotes            TaskNote[]
  taskHistory          TaskHistory[]
  notifications        Notification[]

  createdDocuments   CommunicationDocument[] @relation("DocumentCreator")
  documentRecipients DocumentRecipient[]
  documentSignatures DocumentSignature[]

  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId String?

  // --- RELAÇÕES FINANCEIRAS ---
  createdFinanceEntries FinanceEntry[] @relation("FinanceEntryCreator")
  updatedFinanceEntries FinanceEntry[] @relation("FinanceEntryUpdater")

  @@map("users")
}

model Role {
  id          String   @id @default(nanoid())
  name        String   @unique
  displayName String
  description String?
  color       String?
  permissions Json
  parentId    String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Role?      @relation("RoleHierarchy", fields: [parentId], references: [id])
  children Role[]     @relation("RoleHierarchy")
  users    UserRole[]

  @@map("roles")
}

model UserRole {
  id         String    @id @default(nanoid())
  userId     String
  roleId     String
  expiresAt  DateTime?
  assignedBy String?
  assignedAt DateTime  @default(now())
  metadata   Json?

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model UserSession {
  id           String   @id @default(nanoid())
  userId       String
  refreshToken String   @unique
  fingerprint  String?
  ipAddress    String?
  userAgent    String?
  isActive     Boolean  @default(true)
  lastUsedAt   DateTime @default(now())
  expiresAt    DateTime
  deviceType   String?
  deviceName   String?
  location     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model AuditLog {
  id           String   @id @default(nanoid())
  userId       String?
  action       String
  resource     String
  resourceId   String?
  method       String?
  endpoint     String?
  ipAddress    String
  userAgent    String?
  oldData      Json?
  newData      Json?
  metadata     Json?
  success      Boolean
  errorMessage String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

model RevokedToken {
  id        String   @id @default(nanoid())
  jti       String   @unique
  userId    String?
  reason    String?
  revokedAt DateTime @default(now())
  expiresAt DateTime

  @@index([jti])
  @@index([expiresAt])
  @@map("revoked_tokens")
}

model Setting {
  id          String   @id @default(nanoid())
  key         String   @unique
  value       Json
  type        String
  description String?
  isPublic    Boolean  @default(false)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

model Department {
  id          String   @id @default(nanoid())
  name        String
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users     User[]
  documents CommunicationDocument[]

  @@map("departments")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Workspace {
  id          String   @id @default(uuid())
  name        String
  description String?
  slug        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members           WorkspaceMember[]
  tasks             Task[]
  financeCategories FinanceCategory[]
  financeEntries    FinanceEntry[]
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Task {
  id          String       @id @default(uuid())
  code        Int          @default(autoincrement())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?

  workspaceId String
  creatorId   String 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator   User      @relation("TaskCreator", fields: [creatorId], references: [id])

  assignees   TaskAssignee[]
  checklist   ChecklistItem[]
  attachments TaskAttachment[]
  notes       TaskNote[]
  history     TaskHistory[]
}

model TaskAssignee {
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
}

model ChecklistItem {
  id     String  @id @default(uuid())
  title  String
  isDone Boolean @default(false)
  taskId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskAttachment {
  id         String   @id @default(uuid())
  fileName   String
  fileUrl    String
  fileType   String
  fileSize   Int
  uploadedAt DateTime @default(now())
  taskId     String
  uploaderId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskNote {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  taskId    String
  authorId  String

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])
}

model TaskHistory {
  id        String   @id @default(uuid())
  action    String 
  metadata  Json? 
  createdAt DateTime @default(now())
  taskId    String
  userId    String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  userId    String 
  read      Boolean  @default(false)
  type      String 
  link      String? 
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum DocumentStatus {
  DRAFT
  SENT
  READ
  SIGNED
  ARCHIVED
}

enum DocumentRole {
  TO
  CC
  BCC
}

enum SignatureType {
  DIGITAL
  MANUAL
  BIOMETRIC
}

model CommunicationDocument {
  id             String         @id @default(nanoid())
  protocolNumber String?        @unique @map("protocol_number")
  documentNumber String?        @map("document_number")
  title          String         @db.VarChar(500)
  content        String         @db.Text
  documentType   String         @map("document_type")
  status         DocumentStatus @default(DRAFT)
  priority       TaskPriority   @default(MEDIUM)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  sentAt      DateTime? @map("sent_at")
  deliveredAt DateTime? @map("delivered_at")
  readAt      DateTime? @map("read_at")
  signedAt    DateTime? @map("signed_at")

  originalHash String? @map("original_hash") @db.VarChar(128)
  currentHash  String? @map("current_hash") @db.VarChar(128)
  qrCodeHash   String? @map("qr_code_hash") @db.VarChar(128)

  createdBy String @map("created_by")
  creator   User   @relation("DocumentCreator", fields: [createdBy], references: [id])

  departmentId String?     @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id])

  recipients  DocumentRecipient[]
  signatures  DocumentSignature[]
  attachments CommunicationAttachment[]
  metadata    Json?

  protocol   Protocol? @relation(fields: [protocolId], references: [id])
  protocolId String?   @unique @map("protocol_id")

  pageCount Int? @default(1) @map("page_count")

  @@map("communication_documents")
}

model DocumentRecipient {
  id         String       @id @default(nanoid())
  documentId String       @map("document_id")
  userId     String       @map("user_id")
  role       DocumentRole @default(TO)

  canView Boolean @default(true) @map("can_view")
  canSign Boolean @default(false) @map("can_sign")

  readAt   DateTime? @map("read_at")
  signedAt DateTime? @map("signed_at")

  readIp        String? @map("read_ip") @db.VarChar(45)
  readLocation  String? @map("read_location") @db.VarChar(200)
  readUserAgent String? @map("read_user_agent")
  readDeviceId  String? @map("read_device_id") @db.VarChar(100)

  document CommunicationDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User                  @relation(fields: [userId], references: [id])

  @@map("document_recipients")
}

model DocumentSignature {
  id              String        @id @default(nanoid())
  documentId      String        @map("document_id")
  userId          String        @map("user_id")
  signatureType   SignatureType @map("signature_type")
  certificateData Json?         @map("certificate_data")

  signedAt      DateTime  @default(now()) @map("signed_at")
  ipAddress     String?   @map("ip_address") @db.VarChar(45)
  validityUntil DateTime? @map("validity_until")
  isValid       Boolean   @default(true) @map("is_valid")
  sealData      Json?     @map("seal_data")

  document CommunicationDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User                  @relation(fields: [userId], references: [id])

  @@map("document_signatures")
}

model CommunicationAttachment {
  id         String @id @default(nanoid())
  documentId String @map("document_id")
  fileName   String @map("file_name")
  fileUrl    String @map("file_url")
  fileType   String @map("file_type")
  fileSize   Int    @map("file_size")

  uploadedAt DateTime @default(now()) @map("uploaded_at")

  document CommunicationDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("communication_attachments")
}

model Protocol {
  id             String   @id @default(nanoid())
  protocolNumber String   @unique @map("protocol_number")
  year           Int
  createdAt      DateTime @default(now()) @map("created_at")

  document CommunicationDocument?

  @@map("protocols")
}

// --- MODELOS FINANCEIROS (MVP) ---

enum FinanceEntryType {
  EXPENSE
  INCOME
}

model FinanceCategory {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries   FinanceEntry[]

  @@unique([workspaceId, name])
  @@map("finance_categories")
}

model FinanceEntry {
  id                String           @id @default(uuid())
  workspaceId       String
  occurredAt        DateTime
  description       String
  amountCents       Int
  type              FinanceEntryType @default(EXPENSE)
  categoryId        String?
  attachmentsStatus String           @default("none")
  createdById       String
  updatedById       String?
  deletedAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy User             @relation("FinanceEntryCreator", fields: [createdById], references: [id])
  updatedBy User?            @relation("FinanceEntryUpdater", fields: [updatedById], references: [id])

  @@index([workspaceId, occurredAt])
  @@index([categoryId])
  @@map("finance_entries")
}